<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/backgroundHighlight"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.spotify.watchfeed.discovery.pivotinghostpage.NineBySixteenAspectRatioConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.cardview.widget.CardView
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardBackgroundColor="?attr/baseBackgroundBase"
            app:cardCornerRadius="@dimen/discovery_feed_card_corner_radius"
            app:cardElevation="0dp">
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmer_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.spotify.appendix.pageloaderskeleton.RoundedRectView
                        android:id="@+id/entity_image"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginBottom="38dp"
                        android:layout_marginStart="@dimen/spacer_16"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:roundedrect_color="@color/skeleton_base_color"
                        app:roundedrect_radius="4dp"/>
                    <com.spotify.appendix.pageloaderskeleton.RoundedRectView
                        android:id="@+id/entity_title"
                        android:layout_width="200dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="@dimen/spacer_16"
                        app:layout_constraintBottom_toTopOf="@+id/entity_subtitle"
                        app:layout_constraintStart_toEndOf="@+id/entity_image"
                        app:layout_constraintTop_toTopOf="@+id/entity_image"
                        app:layout_constraintVertical_chainStyle="packed"
                        app:roundedrect_color="@color/skeleton_base_color"
                        app:roundedrect_radius="8dp"/>
                    <com.spotify.appendix.pageloaderskeleton.RoundedRectView
                        android:id="@+id/entity_subtitle"
                        android:layout_width="120dp"
                        android:layout_height="16dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginStart="@dimen/spacer_16"
                        app:layout_constraintBottom_toBottomOf="@+id/entity_image"
                        app:layout_constraintStart_toEndOf="@+id/entity_image"
                        app:layout_constraintTop_toBottomOf="@+id/entity_title"
                        app:layout_constraintVertical_chainStyle="packed"
                        app:roundedrect_color="@color/skeleton_base_color"
                        app:roundedrect_radius="8dp"/>
                    <com.spotify.appendix.pageloaderskeleton.RoundedRectView
                        android:id="@+id/action_button_4"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginBottom="@dimen/spacer_24"
                        app:layout_constraintBottom_toTopOf="@+id/action_button_3"
                        app:layout_constraintEnd_toEndOf="@+id/action_button_1"
                        app:layout_constraintStart_toStartOf="@+id/action_button_1"
                        app:roundedrect_color="@color/skeleton_base_color"
                        app:roundedrect_radius="12dp"/>
                    <com.spotify.appendix.pageloaderskeleton.RoundedRectView
                        android:id="@+id/action_button_3"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginBottom="@dimen/spacer_24"
                        app:layout_constraintBottom_toTopOf="@+id/action_button_2"
                        app:layout_constraintEnd_toEndOf="@+id/action_button_1"
                        app:layout_constraintStart_toStartOf="@+id/action_button_1"
                        app:roundedrect_color="@color/skeleton_base_color"
                        app:roundedrect_radius="12dp"/>
                    <com.spotify.appendix.pageloaderskeleton.RoundedRectView
                        android:id="@+id/action_button_2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginBottom="@dimen/spacer_24"
                        app:layout_constraintBottom_toTopOf="@+id/action_button_1"
                        app:layout_constraintEnd_toEndOf="@+id/action_button_1"
                        app:layout_constraintStart_toStartOf="@+id/action_button_1"
                        app:roundedrect_color="@color/skeleton_base_color"
                        app:roundedrect_radius="12dp"/>
                    <com.spotify.appendix.pageloaderskeleton.RoundedRectView
                        android:id="@+id/action_button_1"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="@dimen/spacer_16"
                        app:layout_constraintBottom_toBottomOf="@+id/entity_image"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/entity_image"
                        app:roundedrect_color="@color/skeleton_base_color"
                        app:roundedrect_radius="16dp"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>
        </androidx.cardview.widget.CardView>
    </com.spotify.watchfeed.discovery.pivotinghostpage.NineBySixteenAspectRatioConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
