<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/content"
    android:background="@color/sthlm_blk"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginTop="?attr/actionBarSize">
    <LinearLayout
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textAppearance="@style/TextAppearance.Encore.TitleMedium"
            android:textColor="@color/sthlm_blk_white"
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/header_phone_number_signup_phone_number"
            android:textDirection="locale"
            android:textAlignment="gravity"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/validate_otp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="noExcludeDescendants">
                <com.spotify.login.adaptiveauthentication.challenge.smscode.OtpInputView
                    android:id="@+id/otp_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.Encore.BodySmall"
                    android:gravity="center_horizontal"
                    android:id="@+id/otp_mismatch"
                    android:padding="16dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.Encore.BodySmall"
                    android:gravity="center_horizontal"
                    android:id="@+id/otp_description"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <Button
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/validate_otp_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:text="@string/button_validate_otp"
                    android:filterTouchesWhenObscured="false"
                    style="@style/Widget.Glue.Button.Primary.White"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/resend_sms"
                    android:padding="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/text_view_icon_padding"
                    android:filterTouchesWhenObscured="true"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/edit_phone_number"
                    android:padding="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/button_edit_phone_number"
                    android:drawablePadding="@dimen/text_view_icon_padding"
                    android:filterTouchesWhenObscured="true"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
