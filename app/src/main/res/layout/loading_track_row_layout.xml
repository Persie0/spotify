<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loading_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:shimmer_base_alpha="1"
    app:shimmer_base_color="@color/loading_track_row_base_color"
    app:shimmer_colored="true"
    app:shimmer_duration="@integer/loading_track_row_shimmer_duration"
    app:shimmer_highlight_alpha="1"
    app:shimmer_highlight_color="@color/loading_track_row_highlight_color">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/loading_constraint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/loading_image"
            android:background="@color/loading_track_row_base_color"
            android:layout_width="@dimen/track_row_cover_art_size"
            android:layout_height="@dimen/track_row_cover_art_size"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/loading_title"
            android:background="@drawable/loading_track_row_title"
            android:layout_width="140sp"
            android:layout_height="16sp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toTopOf="@+id/loading_subtitle"
            app:layout_constraintStart_toEndOf="@+id/loading_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <View
            android:id="@+id/loading_subtitle"
            android:background="@drawable/loading_track_row_subtitle"
            android:layout_width="130sp"
            android:layout_height="13sp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/loading_image"
            app:layout_constraintTop_toBottomOf="@+id/loading_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
