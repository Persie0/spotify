<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:layout_gravity="center"
    android:id="@+id/player_overlay_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.spotify.nowplaying.uiusecases.closebutton.CloseButtonNowPlaying
        android:id="@+id/close_button"
        android:layout_width="@dimen/header_button_size"
        android:layout_height="@dimen/header_button_size"
        android:layout_marginStart="@dimen/header_button_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.spotify.encoremobile.viewstub.EncoreViewStub
        android:id="@+id/ad_context_header_stub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/header_button_margin"
        android:layout_marginEnd="@dimen/header_button_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/context_menu_button"
        app:layout_constraintStart_toEndOf="@+id/close_button"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.spotify.nowplaying.uiusecases.contextmenubutton.ContextMenuButtonNowPlaying
        android:id="@+id/context_menu_button"
        android:padding="@dimen/spacer_8"
        android:layout_width="@dimen/header_button_size"
        android:layout_height="@dimen/header_button_size"
        android:tint="@color/opacity_white_70"
        android:layout_marginEnd="@dimen/header_button_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
