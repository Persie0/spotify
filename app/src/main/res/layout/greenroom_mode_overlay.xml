<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/player_overlay_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/header_top_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/carousel_item_safe_barrier_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="player_overlay_header"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/carousel_item_safe_barrier_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="top"
        app:constraint_referenced_ids="player_overlay_footer"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/player_overlay_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="@dimen/player_controls_bottom_margin"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/track_info_view_container"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.spotify.encoremobile.viewstub.EncoreViewStub
                android:id="@+id/track_info_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="@dimen/spacer_8"
                android:layout_marginBottom="@dimen/std_16dp"
                android:layout_marginEnd="@dimen/spacer_8"
                app:layout_constraintEnd_toStartOf="@+id/add_to_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.spotify.encoremobile.viewstub.EncoreViewStub
                android:id="@+id/add_to_button"
                android:visibility="gone"
                android:layout_width="@dimen/tertiary_button_size"
                android:layout_height="@dimen/tertiary_button_size"
                app:layout_constraintBottom_toBottomOf="@+id/track_info_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/track_info_view"/>
            <com.spotify.encoremobile.viewstub.EncoreViewStub
                android:id="@+id/track_progressbar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/seekbar_height"
                android:layout_marginLeft="@dimen/spacer_8"
                android:layout_marginTop="@dimen/spacer_16"
                android:layout_marginRight="@dimen/spacer_8"
                android:layout_marginHorizontal="@dimen/spacer_8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/track_info_view"/>
            <com.spotify.encoremobile.viewstub.EncoreViewStub
                android:id="@+id/live_progress_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacer_8"
                android:layout_marginTop="5dp"
                android:layout_marginRight="@dimen/spacer_8"
                android:layout_marginBottom="@dimen/spacer_16"
                android:layout_marginHorizontal="@dimen/spacer_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/track_progressbar"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <include layout="@layout/greenroom_mode_playback_controls"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/greenroom_mode_footer"
            android:paddingTop="@dimen/std_16dp"
            android:paddingBottom="@dimen/footer_bottom_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/connect_entry_point"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/quaternary_button_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.spotify.encoremobile.viewstub.EncoreViewStub
                android:id="@+id/share_button"
                android:layout_width="@dimen/quaternary_button_size"
                android:layout_height="@dimen/quaternary_button_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/queue_button"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.spotify.encoremobile.viewstub.EncoreViewStub
                android:id="@+id/queue_button"
                android:visibility="gone"
                android:layout_width="@dimen/quaternary_button_size"
                android:layout_height="@dimen/quaternary_button_size"
                android:layout_marginStart="@dimen/footer_button_margin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
