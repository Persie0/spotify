<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.spotify.encoreconsumermobile.elements.artwork.ArtworkView
        android:id="@+id/art_work_view"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Encore.Elements.Artwork.Row"/>
    <com.spotify.encoreconsumermobile.elements.previewbutton.PreviewOverlayView
        android:id="@+id/preview_overlay_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/art_work_view"
        app:layout_constraintEnd_toEndOf="@+id/art_work_view"
        app:layout_constraintStart_toStartOf="@+id/art_work_view"
        app:layout_constraintTop_toTopOf="@+id/art_work_view"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/play_indicator"
        android:layout_width="12dp"
        android:layout_height="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/art_work_view"
        app:layout_constraintEnd_toEndOf="@+id/art_work_view"
        app:layout_constraintStart_toStartOf="@+id/art_work_view"
        app:layout_constraintTop_toTopOf="@+id/art_work_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
