<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row_root"
    android:background="@drawable/plan_details_card_background"
    android:paddingLeft="@dimen/benefits_list_row_padding"
    android:paddingTop="8dp"
    android:paddingRight="@dimen/benefits_list_row_padding"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:paddingHorizontal="@dimen/benefits_list_row_padding"
    android:paddingVertical="8dp">
    <com.spotify.legacyglue.icons.SpotifyIconView
        android:id="@+id/spotify_icon"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginTop="2dp"
        android:contentDescription="@null"
        app:iconColor="?attr/baseTextBrightAccent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/benefit_description"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="?attr/baseTextBase"
        android:gravity="center_vertical"
        android:id="@+id/benefit_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        android:layout_marginStart="11dp"
        app:layout_constraintBottom_toTopOf="@+id/benefit_subtext"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/spotify_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="?attr/baseTextSubdued"
        android:gravity="center_vertical"
        android:id="@+id/benefit_subtext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        android:layout_marginStart="11dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/spotify_icon"
        app:layout_constraintTop_toBottomOf="@+id/benefit_description"/>
</androidx.constraintlayout.widget.ConstraintLayout>
