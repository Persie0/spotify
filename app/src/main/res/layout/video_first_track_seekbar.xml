<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="false"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.spotify.nowplaying.uiusecases.seekbar.SuppressLayoutTextView
        android:textAppearance="@style/TextAppearance.NowPlayingTimestamps"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="left"
        android:id="@+id/position_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacer_8"
        android:maxLines="1"
        android:layout_marginStart="@dimen/spacer_8"
        android:fontFeatureSettings="tnum"
        app:layout_constraintBottom_toTopOf="@+id/center_guideline"
        app:layout_constraintEnd_toStartOf="@+id/out_of_label"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.NowPlayingTimestamps"
        android:textColor="@color/seekbar_white_70"
        android:id="@+id/out_of_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/position_duration_separator"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/position_text"
        app:layout_constraintEnd_toStartOf="@+id/duration_text"
        app:layout_constraintStart_toEndOf="@+id/position_text"
        app:layout_constraintTop_toTopOf="@+id/position_text"/>
    <com.spotify.nowplaying.uiusecases.seekbar.SuppressLayoutTextView
        android:textAppearance="@style/TextAppearance.NowPlayingTimestamps"
        android:textColor="@color/seekbar_white_70"
        android:id="@+id/duration_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:fontFeatureSettings="tnum"
        app:layout_constraintBottom_toBottomOf="@+id/position_text"
        app:layout_constraintStart_toEndOf="@+id/out_of_label"
        app:layout_constraintTop_toTopOf="@+id/position_text"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/center_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <com.spotify.encoremobile.widgets.CancellableSeekBar
        android:id="@+id/seekbar"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/np_content_desc_seekbar"
        android:layoutDirection="ltr"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/VideoFirstNowPlayingSeekBar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
