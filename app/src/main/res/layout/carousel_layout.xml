<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.TitleSmall"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/recommendation_card_horizontal_margin"
        android:layout_marginTop="@dimen/recommendation_card_vertical_spacing"
        android:layout_marginRight="@dimen/recommendation_card_horizontal_margin"
        android:layout_marginBottom="@dimen/recommendation_card_vertical_spacing"
        android:layout_marginHorizontal="@dimen/recommendation_card_horizontal_margin"
        android:layout_marginVertical="@dimen/recommendation_card_vertical_spacing"
        style="@style/Encore.Components.SectionHeading.Title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/carousel_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
