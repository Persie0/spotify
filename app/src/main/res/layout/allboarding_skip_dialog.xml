<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/allboarding_skip_dialog"
    android:background="@drawable/allboarding_skip_dialog_background"
    android:paddingTop="@dimen/allboarding_skip_dialog_vertical_window_margin"
    android:paddingBottom="@dimen/allboarding_skip_dialog_vertical_window_margin"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ScrollView
        android:id="@+id/content"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:paddingStart="@dimen/allboarding_skip_dialog_content_horizontal_margin"
        android:paddingEnd="@dimen/allboarding_skip_dialog_content_horizontal_margin">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.spotify.encoremobile.component.textview.EncoreTextView
                android:textAppearance="@style/TextAppearance.Encore.TitleMedium"
                android:textColor="@color/black"
                android:gravity="center_horizontal"
                android:id="@+id/allboarding_skip_dialog_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/allboarding_skip_dialog_vertical_window_margin"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <com.spotify.encoremobile.component.textview.EncoreTextView
                android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
                android:textColor="@color/black"
                android:gravity="center_horizontal"
                android:id="@+id/allboarding_skip_dialog_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/buttonPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/allboarding_skip_dialog_button_margin"
        android:paddingStart="@dimen/spacer_24"
        android:paddingEnd="@dimen/spacer_24">
        <Button
            android:ellipsize="end"
            android:id="@+id/allboarding_skip_dialog_skip_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:filterTouchesWhenObscured="true"
            style="?attr/glueButtonPrimaryGreen"/>
        <Button
            android:textColor="@color/black"
            android:ellipsize="end"
            android:id="@+id/allboarding_skip_dialog_continue_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:filterTouchesWhenObscured="true"
            style="?attr/glueButtonSecondary"/>
    </LinearLayout>
</LinearLayout>
