<?xml version="1.0" encoding="utf-8"?>
<com.spotify.legacyglue.gluelib.patterns.header.headers.NonOverlappingLinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.spotify.legacyglue.imageview.FlexibleSquareImageView
        android:layout_gravity="center"
        android:id="@+id/cover_art_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:minWidth="160dp"
        app:widthFraction="@fraction/header_cover_art_screen_width_percentage"/>
    <TextView
        android:ellipsize="end"
        android:id="@android:id/text1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        app:autoSizeTextType="uniform"
        style="@style/Widget.Header.Title.Small"/>
    <TextView
        android:id="@android:id/text2"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        style="@style/Widget.Header.Subtitle.Small"/>
    <TextView
        android:id="@+id/metadata"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textAllCaps="true"
        style="@style/Widget.Header.Metadata"/>
</com.spotify.legacyglue.gluelib.patterns.header.headers.NonOverlappingLinearLayout>
