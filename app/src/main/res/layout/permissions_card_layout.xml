<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:color="?attr/baseBackgroundElevatedBase"
    card_view:cardCornerRadius="@dimen/spacer_16">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/permissions_card_root"
        android:background="?attr/backgroundElevatedBase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textAppearance="@style/TextAppearance.Encore.BodyMediumBold"
            android:textColor="?attr/textBase"
            android:id="@+id/permissions_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/spacer_16"
            android:layout_marginTop="@dimen/spacer_12"
            android:layout_marginRight="@dimen/spacer_16"
            android:layout_marginBottom="@dimen/spacer_8"
            android:layout_marginHorizontal="@dimen/spacer_16"
            card_view:layout_constraintBottom_toTopOf="@+id/permissions_body"
            card_view:layout_constraintEnd_toEndOf="parent"
            card_view:layout_constraintStart_toStartOf="parent"
            card_view:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Encore.BodySmall"
            android:textColor="?attr/baseTextSubdued"
            android:id="@+id/permissions_body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/spacer_16"
            android:layout_marginRight="@dimen/spacer_16"
            android:layout_marginBottom="@dimen/spacer_12"
            android:layout_marginHorizontal="@dimen/spacer_16"
            card_view:layout_constraintBottom_toTopOf="@+id/permissions_button"
            card_view:layout_constraintEnd_toEndOf="parent"
            card_view:layout_constraintStart_toStartOf="parent"
            card_view:layout_constraintTop_toBottomOf="@+id/permissions_headline"/>
        <com.spotify.encoremobile.component.buttons.EncoreButton
            android:id="@+id/permissions_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/spacer_16"
            android:layout_marginRight="@dimen/spacer_16"
            android:minHeight="@dimen/spacer_32"
            android:filterTouchesWhenObscured="false"
            android:layout_marginHorizontal="@dimen/spacer_16"
            card_view:layout_constraintBottom_toTopOf="@+id/bottom_space"
            card_view:layout_constraintEnd_toEndOf="parent"
            card_view:layout_constraintHorizontal_bias="0"
            card_view:layout_constraintStart_toStartOf="parent"
            card_view:layout_constraintTop_toBottomOf="@+id/permissions_body"
            style="@style/Encore.Button.Primary.Small"/>
        <Space
            android:id="@+id/bottom_space"
            android:layout_width="0dp"
            android:layout_height="@dimen/spacer_16"
            card_view:layout_constraintBottom_toBottomOf="parent"
            card_view:layout_constraintEnd_toEndOf="parent"
            card_view:layout_constraintStart_toStartOf="parent"
            card_view:layout_constraintTop_toBottomOf="@+id/permissions_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
