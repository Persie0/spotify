<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row_root"
    android:paddingTop="@dimen/row_vertical_padding"
    android:paddingBottom="@dimen/row_vertical_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/row_horizontal_padding"
    android:paddingVertical="@dimen/row_vertical_padding">
    <com.spotify.encoreconsumermobile.elements.artwork.ArtworkView
        android:id="@+id/artwork"
        android:layout_width="@dimen/music_and_talk_episode_cover_art_size"
        android:layout_height="@dimen/music_and_talk_episode_cover_art_size"
        android:scaleType="centerCrop"
        app:iconInsetRatio="0.5"
        app:layout_constraintBottom_toTopOf="@+id/bottom_barrier"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.spotify.search.uiusecases.PlayIndicatorComposeView
        android:id="@+id/play_indicator"
        android:visibility="gone"
        android:layout_width="@dimen/encore_play_indicator_default_size"
        android:layout_height="@dimen/encore_play_indicator_default_size"
        android:layout_marginStart="@dimen/row_default_horizontal_spacing"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintStart_toEndOf="@+id/artwork"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.MarginalBold"
        android:textColor="@color/encore_row_subtitle"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/pretitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/row_default_text_vertical_spacing"
        android:maxLines="1"
        android:textDirection="locale"
        android:layout_marginStart="@dimen/row_default_horizontal_spacing"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toEndOf="@+id/artwork"
        app:layout_constraintTop_toTopOf="@+id/artwork"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
        android:textColor="@color/encore_row_title"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        android:textAlignment="gravity"
        android:layout_marginStart="@dimen/encore_badge_margin"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintEnd_toStartOf="@+id/action_bar"
        app:layout_constraintStart_toEndOf="@+id/play_indicator"
        app:layout_constraintTop_toBottomOf="@+id/pretitle"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="@dimen/row_horizontal_padding"
        app:layout_goneMarginStart="@dimen/row_default_horizontal_spacing"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/badges_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="artwork"/>
    <Space
        android:id="@+id/badges_space"
        android:layout_width="@dimen/spacer_12"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@+id/badges_barrier"/>
    <com.spotify.encoreconsumermobile.elements.badge.locked.LockedBadgeView
        android:id="@+id/locked_badge"
        android:visibility="gone"
        android:layout_width="@dimen/encore_badge_size"
        android:layout_height="@dimen/encore_badge_size"
        android:layout_marginEnd="@dimen/encore_badge_margin"
        app:layout_constraintBottom_toBottomOf="@+id/subtitle"
        app:layout_constraintEnd_toStartOf="@+id/restriction_badge"
        app:layout_constraintStart_toEndOf="@+id/badges_space"
        app:layout_constraintTop_toTopOf="@+id/subtitle"
        style="@style/LockedBadgeViewInText"/>
    <com.spotify.encoreconsumermobile.elements.badge.contentrestriction.ContentRestrictionBadgeView
        android:id="@+id/restriction_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/encore_badge_size"
        android:layout_marginEnd="@dimen/encore_badge_margin"
        app:layout_constraintBottom_toBottomOf="@+id/subtitle"
        app:layout_constraintEnd_toStartOf="@+id/subtitle"
        app:layout_constraintStart_toEndOf="@+id/locked_badge"
        app:layout_constraintTop_toTopOf="@+id/subtitle"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="@color/encore_row_subtitle"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/row_default_text_vertical_spacing"
        android:maxLines="1"
        android:textDirection="locale"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/release_date"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toEndOf="@+id/restriction_badge"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.spotify.search.uiusecases.actionbarsearch.ActionBarComplexRowSearchView
        android:id="@+id/action_bar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/artwork"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/artwork"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="@color/encore_row_subtitle"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/release_date"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/row_default_text_vertical_spacing"
        android:maxLines="1"
        android:textDirection="locale"
        app:layout_constraintBottom_toBottomOf="@+id/artwork"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/locked_badge"
        app:layout_constraintTop_toBottomOf="@+id/subtitle"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottom_barrier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="artwork,release_date,subtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
