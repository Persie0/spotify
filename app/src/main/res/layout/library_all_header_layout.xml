<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/face_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_container"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth="wrap_content_constrained"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/button_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/face_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/face_header"
        app:layout_constraintTop_toTopOf="@+id/face_header">
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/button_context_menu"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/button_create_container"
            app:layout_constraintStart_toEndOf="@+id/button_search"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/button_create_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/button_settings"
            app:layout_constraintStart_toEndOf="@+id/button_context_menu"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginRight="4dp">
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/button_create"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/library_all_header_create_playlist_icon_content_description"/>
        </FrameLayout>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/button_settings"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/button_play"
            app:layout_constraintStart_toEndOf="@+id/button_create_container"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/button_play"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/button_settings"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.spotify.encoremobile.component.buttons.EncoreButton
            android:id="@+id/button_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/library_all_header_search_icon_content_description"
            app:icon="@drawable/encore_icon_search"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/button_context_menu"
            app:layout_constraintStart_toEndOf="@+id/button_recents"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Encore.Button.Tertiary.Medium.IconOnly"/>
        <com.spotify.encoremobile.component.buttons.EncoreButton
            android:id="@+id/button_recents"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/library_all_header_recents_icon_content_description"
            app:icon="@drawable/encore_icon_recently_played"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/button_search"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Encore.Button.Tertiary.Medium.IconOnly"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
