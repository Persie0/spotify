<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/pci_card_background"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="240dp"
    android:paddingVertical="16dp">
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.TitleSmall"
        android:id="@+id/voting_error_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/pci_error_title"
        app:layout_constraintBottom_toTopOf="@+id/voting_error_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="?attr/baseTextSubdued"
        android:id="@+id/voting_error_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/podcast_poll_voting_error_subtitle"
        app:layout_constraintBottom_toTopOf="@+id/try_voting_again"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voting_error_title"/>
    <com.spotify.encoremobile.buttons.PrimaryButtonView
        android:theme="@style/ThemeOverlay.Encore.Inverted"
        android:id="@+id/try_voting_again"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="24dp"
        android:text="@string/pci_error_retry_button"
        app:actionButtonSize="small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/voting_error_subtitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
