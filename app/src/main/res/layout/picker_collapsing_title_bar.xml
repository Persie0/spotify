<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.appbar.CollapsingToolbarLayout
        android:paddingLeft="@dimen/std_16dp"
        android:paddingRight="@dimen/std_16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/std_16dp"
        app:collapsedTitleGravity="center"
        app:contentScrim="@color/allboarding_stockholm_black_bg"
        app:layout_scrollFlags="exitUntilCollapsed|scroll"
        app:scrimAnimationDuration="300">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_collapseMode="parallax">
            <com.spotify.encoremobile.component.textview.EncoreTextView
                android:id="@+id/expanded_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/std_16dp"
                android:layout_marginBottom="@dimen/std_8dp"
                android:minHeight="?android:attr/actionBarSize"
                android:textAlignment="viewStart"
                android:accessibilityHeading="true"
                app:layout_constrainedWidth="true"
                style="@style/AllBoardingPickerExpandedTitle"/>
        </LinearLayout>
        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:contentInsetLeft="0dp"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp"
            app:layout_collapseMode="pin"
            app:titleTextColor="@color/white">
            <com.spotify.encoremobile.component.textview.EncoreTextView
                android:textAppearance="@style/TextAppearance.Encore.BodyMediumBold"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/collapsed_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="1"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.CollapsingToolbarLayout>
    <FrameLayout
        android:id="@+id/header_title_compose_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_scrollFlags="exitUntilCollapsed|scroll"/>
    <FrameLayout
        android:id="@+id/header_content_compose_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <com.spotify.allboarding.allboardingimpl.search.ui.ToolbarSearchFieldView
        android:id="@+id/search_toolbar"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:layout_marginLeft="@dimen/std_8dp"
        android:layout_marginRight="@dimen/std_8dp"
        android:layout_marginBottom="@dimen/std_8dp"
        android:layout_marginHorizontal="@dimen/std_8dp"
        app:color="@color/allboarding_stockholm_white_searchbar_bg"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/filters_rv"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="@dimen/std_16dp"
        android:clipToPadding="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"/>
    <FrameLayout
        android:id="@+id/filters_compose_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</merge>
