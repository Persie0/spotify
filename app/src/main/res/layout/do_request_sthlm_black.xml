<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.TitleMedium"
        android:textColor="@color/sthlm_blk_white"
        android:layout_gravity="start"
        android:id="@+id/request_magiclink_input_username_heading"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/magiclink_username_input_heading_alt"
        android:labelFor="@+id/login_password_reset_email_input"
        app:layout_constraintEnd_toEndOf="@+id/login_password_reset_email_input"
        app:layout_constraintStart_toStartOf="@+id/login_password_reset_email_input"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:id="@+id/login_password_reset_email_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:inputType="textAutoComplete"
        android:imeOptions="actionDone"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/request_magiclink_input_username_heading"
        style="@style/SthlmBlkLoginFieldInput"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:id="@+id/login_email_info_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/magiclink_username_input_info"
        app:layout_constraintEnd_toEndOf="@+id/login_password_reset_email_input"
        app:layout_constraintStart_toStartOf="@+id/login_password_reset_email_input"
        app:layout_constraintTop_toBottomOf="@+id/login_password_reset_email_input"/>
    <Button
        android:enabled="false"
        android:layout_gravity="center_horizontal"
        android:id="@+id/login_password_reset_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="15dp"
        android:text="@string/magiclink_cta_button"
        android:filterTouchesWhenObscured="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/login_email_info_message"
        style="?attr/glueButtonPrimaryWhite"/>
    <ProgressBar
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/icn_loading_white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/login_email_info_message"/>
</androidx.constraintlayout.widget.ConstraintLayout>
