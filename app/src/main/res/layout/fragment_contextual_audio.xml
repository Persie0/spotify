<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gray_7"
    android:padding="@dimen/spacer_8"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="wrap"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/content_stack_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no">
                <com.spotify.allboarding.uiusecases.contentstack.ContentStackView
                    android:layout_gravity="center"
                    android:id="@+id/content_stack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/spacer_16"
                    android:layout_marginRight="@dimen/spacer_16"
                    android:importantForAccessibility="no"
                    android:layout_marginHorizontal="@dimen/spacer_16"/>
            </FrameLayout>
            <com.spotify.encoremobile.component.textview.EncoreTextView
                android:textAppearance="@style/TextAppearance.Encore.TitleMedium"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacer_16"
                android:layout_marginTop="@dimen/spacer_24"
                android:layout_marginRight="@dimen/spacer_16"
                android:text="@string/contextual_audio_title"
                android:layout_marginHorizontal="@dimen/spacer_16"/>
            <com.spotify.encoremobile.component.textview.EncoreTextView
                android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacer_16"
                android:layout_marginTop="@dimen/spacer_16"
                android:layout_marginRight="@dimen/spacer_16"
                android:text="@string/contextual_audio_subtitle"
                android:layout_marginHorizontal="@dimen/spacer_16"/>
            <com.spotify.encoremobile.component.buttons.EncoreButton
                android:theme="@style/ThemeOverlay.Encore.Inverted"
                android:ellipsize="end"
                android:id="@+id/primary_button"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacer_16"
                android:layout_marginTop="@dimen/spacer_40"
                android:layout_marginRight="@dimen/spacer_16"
                android:text="@string/contextual_audio_primary_button_text"
                android:layout_marginHorizontal="@dimen/spacer_16"
                style="@style/Encore.Button.Primary.Medium"/>
            <com.spotify.encoremobile.component.buttons.EncoreButton
                android:ellipsize="end"
                android:id="@+id/secondary_button"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/spacer_16"
                android:layout_marginTop="@dimen/spacer_16"
                android:layout_marginRight="@dimen/spacer_16"
                android:layout_marginBottom="@dimen/spacer_16"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:text="@string/contextual_audio_secondary_button_text"
                android:filterTouchesWhenObscured="true"
                android:layout_marginHorizontal="@dimen/spacer_16"
                style="@style/Encore.Button.Tertiary.Medium"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/element_buttons_compose_view"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
