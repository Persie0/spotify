<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.spotify.encoremobile.component.textview.EncoreTextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:ellipsize="end"
        android:id="@+id/played_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/check_play_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="wrap"/>
    <com.spotify.encoremobile.component.icons.IconCheckAltFill
        android:id="@+id/check_play_icon"
        android:visibility="gone"
        android:layout_width="@dimen/badge_size"
        android:layout_height="@dimen/badge_size"
        android:tint="?attr/textBrightAccent"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/play_progress"
        app:layout_constraintStart_toEndOf="@+id/played_text"
        app:layout_constraintTop_toTopOf="parent"/>
    <ProgressBar
        android:id="@+id/play_progress"
        android:visibility="gone"
        android:layout_width="@dimen/play_progress_width"
        android:layout_height="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:indeterminate="false"
        android:indeterminateDrawable="@null"
        android:mirrorForRtl="false"
        android:layout_marginVertical="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/check_play_icon"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/PlayProgressbarStyle"/>
</merge>
