<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/section_heading2_root"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.TitleSmall"
        android:id="@+id/section_heading2_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Encore.Components.SectionHeading.Title"/>
    <TextView
        android:id="@+id/section_heading2_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        style="@style/Encore.Components.SectionHeading.Subtitle"/>
</LinearLayout>
