<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/spacer_8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.TitleSmall"
        android:textSize="@dimen/track_info_title_text_size"
        android:textColor="@color/white"
        android:id="@+id/track_info_view_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacer_8"
        app:autoSizeMaxTextSize="18sp"
        app:autoSizeMinTextSize="8sp"
        app:layout_constraintBottom_toTopOf="@+id/track_info_view_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/TrackInfoText"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
        android:textSize="@dimen/track_info_subtitle_text_size"
        android:textColor="@color/opacity_white_70"
        android:id="@+id/track_info_view_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:autoSizeMaxTextSize="18sp"
        app:autoSizeMinTextSize="6sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginLeft="0dp"
        app:layout_goneMarginStart="0dp"
        style="@style/TrackInfoText"/>
</androidx.constraintlayout.widget.ConstraintLayout>
