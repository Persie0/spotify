<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/library_sort_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="yes">
    <com.spotify.encoremobile.component.buttons.EncoreButton
        android:id="@+id/button_sort_order"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="4dp"
        app:icon="@drawable/library_sort_row_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Encore.Button.Tertiary.Small"/>
    <com.spotify.encoremobile.component.buttons.EncoreButton
        android:id="@+id/button_edit"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/library_sort_row_edit_button"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_view_density"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Encore.Button.Tertiary.Small"/>
    <com.spotify.encoremobile.component.buttons.EncoreButton
        android:id="@+id/button_view_density"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:importantForAccessibility="no"
        app:icon="@drawable/encore_icon_grid_view"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Encore.Button.Tertiary.Small.IconOnly"/>
</androidx.constraintlayout.widget.ConstraintLayout>
