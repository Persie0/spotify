<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/heading_container"
        android:paddingLeft="@dimen/adaptive_ui_content_area_horizontal_margin"
        android:paddingRight="@dimen/adaptive_ui_content_area_horizontal_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/adaptive_ui_content_area_horizontal_margin"/>
    <androidx.recyclerview.widget.RecyclerView
        android:orientation="horizontal"
        android:id="@+id/carousel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
