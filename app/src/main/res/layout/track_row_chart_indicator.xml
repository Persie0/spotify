<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="48dp"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/img_indicator_icon_upper"
        android:layout_width="match_parent"
        android:layout_height="@dimen/charts_icon_size"
        android:scaleType="centerInside"
        android:contentDescription="@null"
        app:layout_constraintBottom_toTopOf="@+id/txt_track_row_number"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/txt_track_row_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Encore.Components.TrackRow.TrackNumber"/>
    <ImageView
        android:id="@+id/img_indicator_icon_lower"
        android:layout_width="match_parent"
        android:layout_height="@dimen/charts_icon_size"
        android:scaleType="centerInside"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_track_row_number"/>
</androidx.constraintlayout.widget.ConstraintLayout>
