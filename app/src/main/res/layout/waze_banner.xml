<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/waze_layout"
    android:background="?attr/announcementBackgroundBase"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="?attr/pasteTextAppearanceHeaderSmall"
        android:textSize="20sp"
        android:gravity="center"
        android:id="@+id/waze_exit"
        android:background="@drawable/waze_logo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/MarqueeTextRepeatForever"/>
    <TextView
        android:textAppearance="?attr/pasteTextAppearanceHeaderSmall"
        android:textSize="36sp"
        android:gravity="start|center_vertical"
        android:id="@+id/waze_distance"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/waze_exit"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/MarqueeTextRepeatForever"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/waze_no_distance"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/waze_action"
        app:layout_constraintStart_toEndOf="@+id/waze_exit"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textAppearance="?attr/pasteTextAppearanceBodyMediumBold"
            android:gravity="center"
            android:id="@+id/waze_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/MarqueeTextRepeatForever"/>
        <Button
            android:textAppearance="@style/TextAppearance.Glue.Button"
            android:textSize="12sp"
            android:layout_gravity="center"
            android:id="@+id/waze_get_started"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/waze_get_started"
            android:filterTouchesWhenObscured="false"
            style="?attr/pasteButtonStyleInfoSmall"/>
    </LinearLayout>
    <ImageButton
        android:layout_gravity="top"
        android:id="@+id/waze_action"
        android:background="@android:color/transparent"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:scaleType="centerInside"
        android:contentDescription="@string/generic_content_description_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
