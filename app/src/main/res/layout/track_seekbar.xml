<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:focusable="false"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.spotify.encoremobile.widgets.CancellableSeekBar
        android:layout_gravity="top"
        android:id="@+id/seekbar"
        android:paddingTop="4dp"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/np_content_desc_seekbar"
        android:layoutDirection="ltr"
        style="@style/NowPlayingSeekBar"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:paddingLeft="@dimen/seekbar_padding"
        android:paddingTop="@dimen/seekbar_padding_top"
        android:paddingRight="@dimen/seekbar_padding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.spotify.nowplaying.uiusecases.seekbar.SuppressLayoutTextView
            android:textAppearance="@style/TextAppearance.NowPlayingTimestamps"
            android:layout_gravity="left"
            android:id="@+id/position_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFeatureSettings="tnum"/>
        <com.spotify.nowplaying.uiusecases.seekbar.SuppressLayoutTextView
            android:textAppearance="@style/TextAppearance.NowPlayingTimestamps"
            android:layout_gravity="right"
            android:id="@+id/duration_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textDirection="ltr"
            android:fontFeatureSettings="tnum"/>
    </FrameLayout>
</FrameLayout>
