<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/library_row_cover_art_size"
    android:paddingStart="@dimen/std_16dp">
    <com.spotify.encoreconsumermobile.elements.artwork.ArtworkView
        android:id="@+id/artwork"
        android:duplicateParentState="true"
        android:layout_width="@dimen/library_row_cover_art_size"
        android:layout_height="@dimen/library_row_cover_art_size"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Encore.Elements.Artwork.Row"/>
    <com.spotify.ontour.uiusecases.elements.dateoverlay.DateOverlayView
        android:id="@+id/date_overlay"
        android:visibility="gone"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/artwork"
        app:layout_constraintEnd_toEndOf="@+id/artwork"
        app:layout_constraintStart_toStartOf="@+id/artwork"
        app:layout_constraintTop_toTopOf="@+id/artwork"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/content_column"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/accessory"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/artwork"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="16dp">
        <TextView
            android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
            android:textColor="@color/encore_row_title"
            android:ellipsize="end"
            android:id="@+id/title"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textDirection="locale"
            android:textAlignment="gravity"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/subtitle_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <TextView
                android:textAppearance="@style/TextAppearance.Encore.BodySmall"
                android:textColor="@color/encore_row_subtitle"
                android:ellipsize="end"
                android:id="@+id/subtitle"
                android:duplicateParentState="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:textDirection="locale"
                android:textAlignment="gravity"/>
        </LinearLayout>
        <View
            android:id="@+id/progress"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"/>
    </LinearLayout>
    <com.spotify.yourlibrary.uiusecases.elements.accessory.AccessoryView
        android:id="@+id/accessory"
        android:visibility="gone"
        android:layout_width="@dimen/track_row_button_size"
        android:layout_height="@dimen/track_row_button_size"
        android:scaleType="centerInside"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@+id/artwork"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/content_column"
        app:layout_constraintTop_toTopOf="@+id/artwork"/>
</androidx.constraintlayout.widget.ConstraintLayout>
