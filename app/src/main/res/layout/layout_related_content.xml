<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.TitleSmall"
        android:textColor="@color/white"
        android:id="@+id/related_content_header"
        android:paddingTop="@dimen/spacer_8"
        android:paddingBottom="@dimen/spacer_8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/related_content_section_header_title"
        android:paddingStart="@dimen/spacer_16"
        android:paddingEnd="0dp"
        android:paddingVertical="@dimen/spacer_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/related_content_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/spacer_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/related_content_header"/>
</androidx.constraintlayout.widget.ConstraintLayout>
