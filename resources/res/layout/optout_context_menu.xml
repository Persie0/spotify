<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/opt_out_background_view"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="600dp">
        <TextView
            android:textAppearance="?attr/pasteTextAppearanceBodyMedium"
            android:id="@+id/optout_title"
            android:paddingLeft="@dimen/std_24dp"
            android:paddingRight="@dimen/std_24dp"
            android:paddingBottom="@dimen/std_24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/std_24dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/optout_menu_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/std_24dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
