<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/duration_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="?attr/textSubdued"
        android:id="@+id/duration_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.spotify.encoremobile.component.icons.IconCheckAltFill
        android:id="@+id/duration_img_played"
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="8dp"
        app:iconActive="true"/>
    <ProgressBar
        android:id="@+id/duration_progress_bar"
        android:visibility="gone"
        android:layout_width="88dp"
        android:layout_height="4dp"
        android:indeterminate="false"
        android:progressDrawable="@drawable/progress_bar"
        android:layout_marginStart="8dp"
        android:mirrorForRtl="false"
        style="?attr/pasteProgressBarStyleHorizontal"/>
</LinearLayout>
