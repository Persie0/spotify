<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row_root"
    android:paddingLeft="16dp"
    android:paddingTop="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:paddingHorizontal="16dp"
    android:paddingVertical="16dp">
    <View
        android:id="@+id/home_background"
        android:background="@drawable/home_background"
        android:focusable="false"
        android:duplicateParentState="true"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/home"
        android:focusable="false"
        android:duplicateParentState="true"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@+id/home_background"
        app:layout_constraintEnd_toEndOf="@+id/home_background"
        app:layout_constraintStart_toStartOf="@+id/home_background"
        app:layout_constraintTop_toTopOf="@+id/home_background"
        app:srcCompat="@drawable/encore_icon_home"
        app:tint="?attr/baseTextSubdued"/>
    <View
        android:id="@+id/home_badge"
        android:background="@drawable/home_badge"
        android:focusable="false"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:layout_marginEnd="1dp"
        app:layout_constraintEnd_toEndOf="@+id/home_background"
        app:layout_constraintTop_toTopOf="@+id/home_background"/>
    <com.spotify.encoremobile.component.textview.EncoreTextView
        android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
        android:textColor="?attr/baseTextBase"
        android:id="@+id/title"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        android:textAlignment="gravity"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintStart_toEndOf="@+id/home_background"
        app:layout_constraintTop_toTopOf="@+id/home_background"/>
    <com.spotify.encoremobile.component.textview.EncoreTextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="?attr/baseTextSubdued"
        android:id="@+id/subtitle"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        android:textAlignment="gravity"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/home_background"
        app:layout_constraintStart_toEndOf="@+id/home_background"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
