<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.spotify.encoremobile.facepile.FaceView
        android:id="@+id/profile_picture"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/comment_edittext"
        app:layout_constraintEnd_toStartOf="@+id/comment_edittext"
        app:layout_constraintStart_toStartOf="parent"/>
    <EditText
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:id="@+id/comment_edittext"
        android:background="@drawable/inset_comment_edittext_background"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="104dp"
        android:hint="@string/comment_input_hint"
        android:includeFontPadding="false"
        android:inputType="textMultiLine"
        android:paddingStart="16dp"
        android:paddingEnd="40dp"
        android:paddingVertical="14dp"
        android:importantForAutofill="no"
        app:layout_constraintBottom_toTopOf="@+id/platform_rules_text"
        app:layout_constraintEnd_toStartOf="@+id/send_button"
        app:layout_constraintStart_toEndOf="@+id/profile_picture"
        app:layout_constraintTop_toBottomOf="parent"
        app:layout_goneMarginEnd="16dp"/>
    <ImageView
        android:id="@+id/timestamp_button"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/encore_icon_time_16"
        android:contentDescription="@string/comment_timestamp_button_content_description"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/comment_edittext"
        app:layout_constraintEnd_toEndOf="@+id/comment_edittext"
        app:layout_constraintTop_toTopOf="@+id/comment_edittext"
        app:tint="?attr/baseTextBase"/>
    <EditText
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:id="@+id/first_comment_edittext"
        android:background="@drawable/inset_comment_edittext_background"
        android:paddingLeft="16dp"
        android:paddingTop="14dp"
        android:paddingRight="16dp"
        android:paddingBottom="14dp"
        android:focusable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxHeight="104dp"
        android:hint="@string/comment_input_hint"
        android:includeFontPadding="false"
        android:inputType="none"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:importantForAutofill="no"
        app:layout_constraintBottom_toBottomOf="@+id/comment_edittext"
        app:layout_constraintEnd_toEndOf="@+id/comment_edittext"
        app:layout_constraintStart_toStartOf="@+id/comment_edittext"
        app:layout_constraintTop_toTopOf="@+id/comment_edittext"/>
    <Space
        android:id="@+id/send_button_space"
        android:layout_width="0dp"
        android:layout_height="4dp"
        app:layout_constraintTop_toBottomOf="@+id/comment_edittext"/>
    <com.spotify.encoremobile.component.buttons.EncoreButton
        android:theme="@style/ThemeOverlay.Encore.BrightAccent"
        android:id="@+id/send_button"
        android:background="@drawable/inset_send_button_background"
        android:padding="6dp"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/comment_send_button_content_description"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="10dp"
        app:icon="@drawable/encore_icon_arrow_up_16"
        app:iconSize="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/send_button_space"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/comment_edittext"
        style="@style/Encore.Button.Primary.Medium.IconOnly"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.Marginal"
        android:textColor="?attr/baseTextSubdued"
        android:textColorLink="?attr/baseTextBase"
        android:gravity="start"
        android:id="@+id/platform_rules_text"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/character_count_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/comment_edittext"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.Marginal"
        android:textColor="?attr/baseTextSubdued"
        android:id="@+id/character_count_text"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/platform_rules_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/platform_rules_text"
        app:layout_constraintTop_toTopOf="@+id/platform_rules_text"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/active_input_group"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="platform_rules_text,character_count_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
