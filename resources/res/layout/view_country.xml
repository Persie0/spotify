<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/background_country_view"
    android:paddingTop="@dimen/encore_spacer_tighter_2"
    android:paddingBottom="@dimen/encore_spacer_tighter_2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/encore_control_size_larger"
    android:paddingStart="@dimen/encore_spacer_base"
    android:paddingEnd="@dimen/encore_spacer_base">
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/checkIcon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.spotify.encoremobile.component.icons.IconCheck
        android:id="@+id/checkIcon"
        android:layout_width="@dimen/encore_spacer_base"
        android:layout_height="@dimen/encore_spacer_base"
        android:layout_marginStart="@dimen/encore_spacer_tighter_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textView"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white"/>
</androidx.constraintlayout.widget.ConstraintLayout>
