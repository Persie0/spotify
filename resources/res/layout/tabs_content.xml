<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cwp_tabs_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/cwp_tab_layout"
            android:tag="tabsContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/encore_box_min_height"
            android:layout_marginLeft="@dimen/spacer_16"
            android:layout_marginRight="@dimen/spacer_16"
            android:layout_marginHorizontal="@dimen/spacer_16"
            app:tabIndicatorFullWidth="false"
            app:tabMode="scrollable"
            app:tabPaddingEnd="0dp"
            app:tabPaddingStart="0dp"
            style="@style/CwpTabAppearance"/>
    </androidx.core.widget.NestedScrollView>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/cwp_view_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</LinearLayout>
