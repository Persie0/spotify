<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textSize="11sp"
        android:textColor="?attr/baseTextSubdued"
        android:ellipsize="end"
        android:id="@+id/content_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dp"
        android:maxLines="1"
        android:textAlignment="viewStart"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodyMediumBold"
        android:textSize="16sp"
        android:textColor="?attr/baseTextBase"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="7"
        android:textAlignment="viewStart"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">
        <com.spotify.encoreconsumermobile.elements.artwork.ArtworkView
            android:id="@+id/artist_artwork"
            android:layout_width="@dimen/std_24dp"
            android:layout_height="@dimen/std_24dp"
            android:layout_marginEnd="@dimen/std_8dp"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Encore.BodySmallBold"
            android:textSize="13sp"
            android:textColor="?attr/baseTextBase"
            android:ellipsize="end"
            android:gravity="start"
            android:id="@+id/subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="7"
            android:textAlignment="viewStart"/>
    </LinearLayout>
</LinearLayout>
