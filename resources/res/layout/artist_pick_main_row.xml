<?xml version="1.0" encoding="utf-8"?>
<com.spotify.encoremobile.component.listrow.EncoreListRow xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row_root"
    android:padding="0dp"
    android:duplicateParentState="true"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:stateListAnimator="@null"
    app:contentPadding="0dp"
    app:layoutSize="xx_large"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    style="@style/Encore.ListRow.Naked">
    <FrameLayout
        android:duplicateParentState="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:slot="media">
        <com.spotify.encoreconsumermobile.elements.artwork.ArtworkView
            android:id="@+id/artist_pick_image"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
        <com.spotify.artist.uiusecases.artistpick.elements.DateIconView
            android:id="@+id/artist_pick_date"
            android:visibility="gone"
            android:duplicateParentState="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"/>
    </FrameLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:slot="pretitle">
        <com.spotify.artist.uiusecases.artistpick.elements.CommentBubbleView
            android:id="@+id/comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <com.spotify.encoremobile.component.textview.EncoreTextView
        android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
        android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:slot="title"/>
    <com.spotify.encoremobile.component.textview.EncoreTextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="?attr/textSubdued"
        android:ellipsize="end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:slot="subtitle"/>
</com.spotify.encoremobile.component.listrow.EncoreListRow>
