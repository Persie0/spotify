<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/encore_header_background_gradient"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Space
        android:id="@+id/content_space"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/header_content_start_margin"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/header_content_end_margin"/>
    <com.spotify.encoreconsumermobile.elements.artwork.ArtworkView
        android:id="@+id/hero_artwork"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.spotify.encoreconsumermobile.elements.artwork.ArtworkView
        android:id="@+id/hero_artwork_next"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:alpha="0"
        app:layout_constraintBottom_toBottomOf="@+id/hero_artwork"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/hero_gradient"
        android:background="@drawable/event_hero_header_gradient"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="164dp"
        app:layout_constraintBottom_toBottomOf="@+id/hero_artwork"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.spotify.liveevents.uiusecases.concertentityheader.elements.CalendarIconView
        android:id="@+id/hero_calendar"
        android:visibility="gone"
        android:layout_width="@dimen/concert_calendar_size"
        android:layout_height="@dimen/concert_calendar_size"
        app:layout_constraintBottom_toTopOf="@+id/hero_title"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"/>
    <TextView
        android:textSize="56sp"
        android:textColor="?attr/baseTextBase"
        android:ellipsize="end"
        android:gravity="bottom"
        android:id="@+id/hero_title"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:fontFamily="@font/spotify_mix_ui_title_extrabold"
        android:letterSpacing="0"
        android:fontFeatureSettings="liga 1"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/hero_subtitle"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodyMediumBold"
        android:textColor="?attr/baseTextSubdued"
        android:ellipsize="end"
        android:id="@+id/hero_subtitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/hero_artwork"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"
        app:layout_constraintTop_toBottomOf="@+id/hero_title"/>
    <com.spotify.encoreconsumermobile.elements.artwork.ArtworkView
        android:id="@+id/artwork"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"
        app:layout_constraintTop_toBottomOf="@+id/content_space"
        style="@style/Encore.Elements.Artwork.Header"/>
    <com.spotify.liveevents.uiusecases.multiavatar.MultiArtistAvatarView
        android:id="@+id/artwork_multiple"
        android:layout_width="wrap_content"
        android:layout_height="96dp"
        android:contentDescription="@null"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"
        app:layout_constraintTop_toBottomOf="@+id/content_space"/>
    <Space
        android:id="@+id/artwork_helper_space"
        android:layout_width="104dp"
        android:layout_height="104dp"
        app:layout_constraintBottom_toBottomOf="@+id/artwork_multiple"
        app:layout_constraintEnd_toEndOf="@+id/artwork_multiple"
        app:layout_constraintStart_toStartOf="@+id/artwork_multiple"
        app:layout_constraintTop_toTopOf="@+id/artwork_multiple"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="artwork_multiple, artwork_helper_space"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="artwork_multiple, artwork_helper_space"/>
    <com.spotify.liveevents.uiusecases.concertentityheader.elements.CalendarIconView
        android:id="@+id/calendar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minWidth="40dp"
        android:minHeight="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/barrier_bottom"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/barrier_end"/>
    <TextView
        android:textSize="@dimen/content_title_max_text_size"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/content_title_vertical_margin"
        android:layout_marginBottom="@dimen/content_title_vertical_margin"
        android:layout_marginVertical="@dimen/content_title_vertical_margin"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/date"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"
        app:layout_constraintTop_toBottomOf="@+id/artwork_multiple"
        app:layout_goneMarginTop="?attr/actionBarSize"
        style="@style/Encore.Components.Headers.Title"/>
    <TextView
        android:id="@+id/date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_goneMarginTop="@dimen/content_description_vertical_margin"
        style="@style/Encore.Components.Headers.Description"/>
    <TextView
        android:id="@+id/venue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"
        app:layout_constraintTop_toBottomOf="@+id/date"
        app:layout_goneMarginTop="@dimen/content_description_vertical_margin"
        style="@style/Encore.Components.Headers.Description"/>
    <TextView
        android:ellipsize="end"
        android:id="@+id/lineup_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:singleLine="true"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/action_row_container"
        app:layout_constraintEnd_toStartOf="@+id/postfix_text"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/guideline_start"
        app:layout_constraintTop_toBottomOf="@+id/venue"
        style="@style/Encore.Components.Headers.Metadata"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/postfix_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="@+id/lineup_text"
        app:layout_constraintEnd_toEndOf="@+id/guideline_end"
        app:layout_constraintStart_toEndOf="@+id/lineup_text"
        app:layout_constraintTop_toTopOf="@+id/lineup_text"
        style="@style/Encore.Components.Headers.Metadata"/>
    <Space
        android:id="@+id/content_bottom_space"
        android:layout_width="0dp"
        android:layout_height="8dp"
        app:layout_constraintBottom_toTopOf="@+id/action_row_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/venue"/>
    <View
        android:id="@+id/overlay"
        android:background="@color/opacity_white_0"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/concept_chips_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lineup_text"/>
    <ViewStub
        android:id="@+id/action_row_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/concept_chips_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
