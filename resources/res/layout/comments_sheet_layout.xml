<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/comments_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/end_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="16dp"/>
    <View
        android:id="@+id/comments_sheet_background"
        android:background="@drawable/comments_sheet_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/comments_sheet_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/comments_sheet_handle"
        android:contentDescription="@null"
        app:layout_constraintBottom_toTopOf="@+id/comments_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/comments_sheet_background"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/content_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="close_button,comments_title,entity_title,parent_entity_description,header_divider,input_divider"/>
    <com.spotify.encoremobile.component.buttons.EncoreButton
        android:id="@+id/close_button"
        android:padding="12dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="4dp"
        android:contentDescription="@string/close_comments_sheet_button_content_description"
        app:icon="@drawable/encore_icon_chevron_down_24"
        app:layout_constraintBottom_toBottomOf="@+id/parent_entity_description"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/comments_title"
        style="@style/Encore.Button.Tertiary.Small.IconOnly"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/header_text_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="56dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/header_text_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="56dp"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodyMediumBold"
        android:gravity="center"
        android:id="@+id/comments_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/comments_sheet_title"
        android:maxLines="1"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/entity_title"
        app:layout_constraintEnd_toEndOf="@+id/header_text_end"
        app:layout_constraintStart_toEndOf="@+id/header_text_start"
        app:layout_constraintTop_toBottomOf="@+id/comments_sheet_handle"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.Marginal"
        android:textColor="?attr/baseTextSubdued"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/entity_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/parent_entity_description"
        app:layout_constraintEnd_toEndOf="@+id/header_text_end"
        app:layout_constraintStart_toEndOf="@+id/header_text_start"
        app:layout_constraintTop_toBottomOf="@+id/comments_title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.Marginal"
        android:textColor="?attr/baseTextSubdued"
        android:gravity="center"
        android:id="@+id/parent_entity_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:maxLines="1"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/header_divider"
        app:layout_constraintEnd_toEndOf="@+id/header_text_end"
        app:layout_constraintStart_toEndOf="@+id/header_text_start"
        app:layout_constraintTop_toBottomOf="@+id/entity_title"/>
    <View
        android:id="@+id/header_content_description_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/parent_entity_description"
        app:layout_constraintEnd_toEndOf="@+id/header_text_end"
        app:layout_constraintStart_toStartOf="@+id/header_text_start"
        app:layout_constraintTop_toTopOf="@+id/comments_title"/>
    <View
        android:id="@+id/header_divider"
        android:background="@color/comments_separator"
        android:layout_width="0dp"
        android:layout_height="@dimen/comment_vertical_separator_height"
        app:layout_constraintBottom_toTopOf="@+id/no_comment_state_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/parent_entity_description"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="?attr/baseTextBase"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/no_comment_state_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textDirection="locale"
        app:layout_constraintBottom_toTopOf="@+id/recycler"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/header_divider"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/input_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/no_comment_state_text"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/loading_spinner"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/recycler"
        app:layout_constraintEnd_toEndOf="@+id/recycler"
        app:layout_constraintStart_toStartOf="@+id/recycler"
        app:layout_constraintTop_toTopOf="@+id/recycler"/>
    <View
        android:id="@+id/input_divider"
        android:background="@color/comments_separator"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        app:layout_constraintBottom_toTopOf="@+id/cancel_reply_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/recycler"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.Marginal"
        android:textColor="?attr/baseTextSubdued"
        android:id="@+id/replying_to_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAlignment="viewStart"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/cancel_reply_button"
        app:layout_constraintEnd_toStartOf="@+id/cancel_reply_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cancel_reply_button"/>
    <com.spotify.encoremobile.component.buttons.EncoreButton
        android:id="@+id/cancel_reply_button"
        android:paddingLeft="16dp"
        android:paddingTop="10dp"
        android:paddingRight="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="36dp"
        android:contentDescription="@string/cancel_reply_button_content_description"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        app:icon="@drawable/encore_icon_x"
        app:iconSize="16dp"
        app:iconTint="?attr/baseTextSubdued"
        app:layout_constraintBottom_toTopOf="@+id/comment_input_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/replying_to_text"
        app:layout_constraintTop_toBottomOf="@+id/input_divider"
        style="@style/Encore.Button.Tertiary.Small.IconOnly"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/replying_to_group"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="replying_to_text,cancel_reply_button"/>
    <include
        android:id="@+id/comment_input_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="42dp"
        app:layout_constraintBottom_toTopOf="@+id/input_disabled_reason"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cancel_reply_button"
        app:layout_goneMarginTop="8dp"
        layout="@layout/comment_input_bar_layout"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.Marginal"
        android:textColor="?attr/baseTextSubdued"
        android:gravity="center"
        android:id="@+id/input_disabled_reason"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:layout_marginVertical="24dp"
        app:layout_constraintBottom_toTopOf="@+id/show_all_comments_button"
        app:layout_constraintEnd_toEndOf="@+id/end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/comment_input_bar"/>
    <com.spotify.encoremobile.component.buttons.EncoreButton
        android:theme="@style/ThemeOverlay.Encore.Inverted"
        android:textAppearance="@style/TextAppearance.Encore.BodySmallBold"
        android:ellipsize="end"
        android:id="@+id/show_all_comments_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_marginBottom="24dp"
        android:text="@string/show_all_comments_button_title"
        android:maxLines="1"
        android:contentDescription="@string/show_all_comments_button_title"
        android:layout_marginHorizontal="16dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/input_disabled_reason"
        style="@style/Encore.Button.Primary.Small"/>
    <include
        android:id="@+id/progress_dots_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/comment_progress_dots_overlay_layout"/>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/snackbarContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="4dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintBottom_toTopOf="@+id/input_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
