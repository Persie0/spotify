<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/concert_view"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.spotify.liveevents.uiusecases.concertentityheader.elements.CalendarIconView
        android:id="@+id/concert_calendar_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/concert_title"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/concert_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/concert_save_button"
        app:layout_constraintStart_toEndOf="@+id/concert_calendar_icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="?attr/baseTextSubdued"
        android:ellipsize="end"
        android:id="@+id/concert_subtitle"
        android:duplicateParentState="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guide_row_end"
        app:layout_constraintStart_toEndOf="@+id/concert_calendar_icon"
        app:layout_constraintTop_toBottomOf="@+id/concert_title"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/guide_row_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="concert_title, concert_subtitle"/>
    <com.spotify.encoreconsumermobile.elements.addtobutton.EncoreAddToButtonView
        android:id="@+id/concert_save_button"
        android:layout_width="@dimen/add_to_button_size"
        android:layout_height="@dimen/add_to_button_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Encore.Button.Tertiary.Small.IconOnly"/>
</androidx.constraintlayout.widget.ConstraintLayout>
