<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/creatorartist_padding_size"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.spotify.encoremobile.component.listrow.EncoreListRow
        android:id="@+id/registered_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Encore.ListRow.Tinted">
        <com.spotify.encoremobile.component.slottextview.EncoreTitleView
            android:textAppearance="@style/TextAppearance.Encore.BodyMediumBold"
            android:id="@+id/registered_row_title"
            android:paddingTop="@dimen/encore_spacer_tighter_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/registered_in_spotify_for_artists_title"
            app:slot="title"/>
        <com.spotify.encoremobile.component.slottextview.EncoreSubtitleView
            android:textAppearance="@style/TextAppearance.Encore.BodySmall"
            android:textColor="?attr/textSubdued"
            android:id="@+id/registered_row_subtitle"
            android:paddingBottom="@dimen/encore_spacer_tighter_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/registered_in_spotify_for_artists_subtitle"
            app:slot="subtitle"/>
    </com.spotify.encoremobile.component.listrow.EncoreListRow>
</FrameLayout>
