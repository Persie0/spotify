<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/now_playing_bar_hat_layout"
    android:background="@drawable/floating_layout_bg"
    android:paddingLeft="@dimen/spacer_8"
    android:paddingRight="@dimen/spacer_8"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/now_playing_bar_hat_height"
    android:layout_marginLeft="@dimen/floating_now_playing_bar_margin"
    android:layout_marginRight="@dimen/floating_now_playing_bar_margin"
    android:layout_marginHorizontal="@dimen/floating_now_playing_bar_margin"
    android:paddingHorizontal="@dimen/spacer_8">
    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/spacer_16"
        android:layout_height="@dimen/spacer_16"
        app:layout_constraintBottom_toTopOf="@+id/bottom_spacer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white"/>
    <com.spotify.encoremobile.component.textview.EncoreTextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/spacer_12"
        app:layout_constraintBottom_toTopOf="@+id/bottom_spacer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/bottom_spacer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/spacer_8"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
