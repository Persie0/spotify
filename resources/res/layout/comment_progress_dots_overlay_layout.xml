<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/comments_progress_dots_overlay_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/progress_dots_background"
        android:background="@drawable/comments_progress_dots_background"
        android:layout_width="140dp"
        android:layout_height="140dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/progress_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/progress_dots_background"
        app:layout_constraintEnd_toEndOf="@+id/progress_dots_background"
        app:layout_constraintStart_toStartOf="@+id/progress_dots_background"
        app:layout_constraintTop_toTopOf="@+id/progress_dots_background"/>
</androidx.constraintlayout.widget.ConstraintLayout>
