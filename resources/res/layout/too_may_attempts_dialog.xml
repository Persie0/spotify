<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_history_menu_bottom"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
    <TextView
        android:textColor="@color/gray_7"
        android:gravity="center"
        android:id="@+id/textView_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/std_32dp"
        android:text="@string/magiclink_too_many_attempts_dialog_title"
        android:layout_marginStart="@dimen/std_24dp"
        android:layout_marginEnd="@dimen/std_24dp"
        app:layout_constraintBottom_toTopOf="@+id/textView_description"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/Widget.Login.TextView.Title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
        android:textColor="@color/gray_7"
        android:gravity="center"
        android:id="@+id/textView_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="@dimen/std_24dp"
        android:layout_marginEnd="@dimen/std_24dp"
        app:layout_constraintBottom_toTopOf="@+id/button_positive"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_title"/>
    <Button
        android:textColor="@color/black"
        android:id="@+id/button_positive"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/magiclink_too_many_attempts_dialog_open_email_app"
        android:filterTouchesWhenObscured="true"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/std_54dp"
        android:layout_marginEnd="@dimen/std_54dp"
        app:layout_constraintBottom_toTopOf="@+id/textView_or"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_description"
        app:layout_constraintWidth_max="320dp"
        style="@style/Widget.Glue.Button.Primary.Green"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmallBold"
        android:textColor="@color/black"
        android:id="@+id/textView_or"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/magiclink_or"
        android:includeFontPadding="false"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/button_negative"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button_positive"/>
    <View
        android:id="@+id/left_divider_line"
        android:background="@color/opacity_black_50"
        android:layout_width="82dp"
        android:layout_height="1dp"
        android:layout_marginTop="2sp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/textView_or"
        app:layout_constraintRight_toLeftOf="@+id/textView_or"
        app:layout_constraintTop_toTopOf="@+id/textView_or"/>
    <View
        android:id="@+id/right_divider_line"
        android:background="@color/opacity_black_50"
        android:layout_width="82dp"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="2sp"
        app:layout_constraintBottom_toBottomOf="@+id/textView_or"
        app:layout_constraintLeft_toRightOf="@+id/textView_or"
        app:layout_constraintTop_toTopOf="@+id/textView_or"/>
    <Button
        android:textSize="12sp"
        android:id="@+id/button_negative"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="@string/magiclink_too_many_attempts_dialog_open_try_another_password"
        android:filterTouchesWhenObscured="true"
        android:layout_marginStart="@dimen/std_54dp"
        android:layout_marginEnd="@dimen/std_54dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_or"
        app:layout_constraintWidth_max="320dp"
        app:layout_goneMarginTop="24dp"
        style="@style/GlueExtension.Button.MultiLine.Primary.White"/>
</androidx.constraintlayout.widget.ConstraintLayout>
