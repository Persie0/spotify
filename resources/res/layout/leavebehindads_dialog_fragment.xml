<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/toolbar_root"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:importantForAccessibility="yes">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/close_button"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/std_16dp"
            android:layout_marginStart="@dimen/std_16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textAppearance="@style/TextAppearance.Encore.BodyMediumBold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/leavebehind_ads_page_title"
            android:layout_weight="1"/>
        <Space
            android:layout_gravity="center_vertical"
            android:layout_width="@dimen/std_24dp"
            android:layout_height="0dp"
            android:layout_marginRight="@dimen/std_16dp"
            android:layout_marginEnd="@dimen/std_16dp"/>
    </LinearLayout>
</LinearLayout>
