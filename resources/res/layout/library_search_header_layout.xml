<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.spotify.encoremobile.component.buttons.EncoreButton
        android:id="@+id/icon_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/library_search_cancel_button_content_description"
        android:layout_marginStart="8dp"
        app:icon="@drawable/encore_icon_chevron_left"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/Encore.Button.Tertiary.Medium.IconOnly"/>
    <EditText
        android:textAppearance="?attr/pasteTextAppearanceBodySmallBold"
        android:textColor="@color/white"
        android:textColorHint="@color/library_search_field_hint_color"
        android:id="@+id/edit_text"
        android:background="@drawable/library_search_field_background"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="48dp"
        android:paddingBottom="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="16dp"
        android:minHeight="48dp"
        android:hint="@string/library_search_text_hint"
        android:singleLine="true"
        android:inputType="text"
        android:imeOptions="flagNoExtractUi|actionSearch"
        android:paddingStart="8dp"
        android:paddingEnd="48dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="16dp"
        android:paddingVertical="8dp"
        android:importantForAutofill="no"
        app:layout_constraintBottom_toBottomOf="@+id/icon_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/icon_back"
        app:layout_constraintTop_toTopOf="@+id/icon_back"/>
    <com.spotify.encoremobile.component.buttons.EncoreButton
        android:id="@+id/icon_clear_search"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/library_search_clear_button_content_description"
        app:icon="@drawable/encore_icon_x"
        app:iconTint="@color/library_search_field_clear_icon_color"
        app:layout_constraintBottom_toBottomOf="@+id/edit_text"
        app:layout_constraintEnd_toEndOf="@+id/edit_text"
        app:layout_constraintTop_toTopOf="@+id/edit_text"
        style="@style/Encore.Button.Tertiary.Small.IconOnly"/>
</androidx.constraintlayout.widget.ConstraintLayout>
