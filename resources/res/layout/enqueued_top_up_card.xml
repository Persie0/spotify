<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/baseBackgroundHighlight"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.spotify.encoremobile.component.textview.EncoreTextView
        android:textAppearance="@style/TextAppearance.Encore.BodyMediumBold"
        android:id="@+id/text_view_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_16"
        android:layout_marginStart="@dimen/spacer_16"
        android:layout_marginEnd="@dimen/spacer_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/image_view_purchased_date"
        android:layout_width="@dimen/spacer_16"
        android:layout_height="@dimen/spacer_16"
        android:src="@drawable/encore_icon_released"
        android:tint="?attr/baseTextSubdued"
        android:contentDescription="@string/calender_icon"
        app:layout_constraintBottom_toBottomOf="@+id/text_view_purchased_date"
        app:layout_constraintStart_toStartOf="@+id/text_view_header"
        app:layout_constraintTop_toTopOf="@+id/text_view_purchased_date"/>
    <com.spotify.encoremobile.component.textview.EncoreTextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:gravity="center_vertical"
        android:id="@+id/text_view_purchased_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_12"
        android:minHeight="@dimen/spacer_24"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="@dimen/spacer_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_view_header"/>
    <ImageView
        android:id="@+id/image_view_expire_date"
        android:layout_width="@dimen/spacer_16"
        android:layout_height="@dimen/spacer_16"
        android:layout_marginTop="@dimen/spacer_16"
        android:layout_marginBottom="@dimen/spacer_16"
        android:src="@drawable/encore_icon_time"
        android:tint="?attr/baseTextSubdued"
        android:contentDescription="@string/clock_icon"
        app:layout_constraintBottom_toBottomOf="@+id/text_view_expire_date"
        app:layout_constraintStart_toStartOf="@+id/text_view_header"
        app:layout_constraintTop_toTopOf="@+id/text_view_expire_date"/>
    <com.spotify.encoremobile.component.textview.EncoreTextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:gravity="center_vertical"
        android:id="@+id/text_view_expire_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacer_8"
        android:layout_marginBottom="@dimen/spacer_8"
        android:minHeight="@dimen/spacer_24"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="@dimen/spacer_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/text_view_purchased_date"/>
</androidx.constraintlayout.widget.ConstraintLayout>
