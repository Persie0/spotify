<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/plan_details_card_description"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
        android:textColor="?attr/baseTextSubdued"
        android:id="@+id/description"
        android:paddingLeft="@dimen/spacer_16"
        android:paddingTop="@dimen/spacer_16"
        android:paddingRight="@dimen/spacer_16"
        android:paddingBottom="@dimen/spacer_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        android:paddingHorizontal="@dimen/spacer_16"/>
    <com.spotify.encoremobile.component.buttons.EncoreButton
        android:id="@+id/primary_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="#ffffff"
        style="@style/Encore.Button.Primary.Medium"/>
</LinearLayout>
