<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row_root"
    android:paddingLeft="@dimen/spacer_16"
    android:paddingTop="@dimen/spacer_8"
    android:paddingRight="@dimen/spacer_16"
    android:paddingBottom="@dimen/spacer_8"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacer_16"
    android:paddingVertical="@dimen/spacer_8">
    <com.spotify.encoremobile.facepile.FaceView
        android:id="@+id/member_list_row_avatar"
        android:duplicateParentState="true"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/member_list_row_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
        android:textColor="?attr/baseTextBase"
        android:id="@+id/member_list_row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/member_list_row_account_type"
        app:layout_constraintEnd_toStartOf="@+id/plan_member_check"
        app:layout_constraintStart_toEndOf="@+id/member_list_row_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="?attr/baseTextSubdued"
        android:id="@+id/member_list_row_account_type"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toTopOf="@+id/member_list_row_expiration"
        app:layout_constraintEnd_toStartOf="@+id/plan_member_check"
        app:layout_constraintStart_toEndOf="@+id/member_list_row_avatar"
        app:layout_constraintTop_toBottomOf="@+id/member_list_row_name"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="?attr/baseTextWarning"
        android:id="@+id/member_list_row_expiration"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textDirection="locale"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/plan_member_check"
        app:layout_constraintStart_toEndOf="@+id/member_list_row_avatar"
        app:layout_constraintTop_toBottomOf="@+id/member_list_row_account_type"/>
    <com.spotify.legacyglue.icons.SpotifyIconView
        android:id="@+id/plan_member_check"
        android:visibility="gone"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:layout_marginEnd="16dp"
        app:iconColor="?attr/baseTextSubdued"
        app:iconType="icon_check"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/member_list_row_account_type"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
