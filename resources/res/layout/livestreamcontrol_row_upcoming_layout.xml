<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13sp"
        android:id="@+id/timestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/upcoming_live_audio_event_timestamp_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.spotify.encoremobile.component.buttons.EncoreButton
        android:id="@+id/share_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="-8dp"
        app:icon="@drawable/encore_icon_share_android_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timestamp"
        style="@style/Encore.Button.Tertiary.Medium.IconOnly"/>
    <com.spotify.encoremobile.component.buttons.EncoreButton
        android:id="@+id/add_to_calendar_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:icon="@drawable/encore_icon_add_calendar_24"
        app:layout_constraintBottom_toBottomOf="@+id/share_button"
        app:layout_constraintStart_toEndOf="@+id/share_button"
        app:layout_constraintTop_toTopOf="@+id/share_button"
        style="@style/Encore.Button.Tertiary.Medium.IconOnly"/>
    <com.spotify.encoremobile.component.buttons.EncoreProgressIndicatorButton
        android:theme="@style/ThemeOverlay.Encore.Inverted"
        android:id="@+id/rsvp_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/upcoming_livestream_rsvp_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/share_button"
        style="@style/Encore.Button.Primary.Medium"/>
    <com.spotify.encoremobile.component.buttons.EncoreButton
        android:theme="@style/ThemeOverlay.Encore.Inverted"
        android:id="@+id/notify_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/upcoming_livestream_notify_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/share_button"
        style="@style/Encore.Button.Primary.Medium"/>
    <com.spotify.encoremobile.component.buttons.EncoreButton
        android:id="@+id/will_notify_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/upcoming_livestream_notified_button"
        app:iconGravity="textEnd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/share_button"
        style="@style/Encore.Button.Secondary.Medium"/>
    <com.spotify.encoremobile.component.buttons.EncoreButton
        android:id="@+id/view_event_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/upcoming_live_audio_event_view_event_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/share_button"
        style="@style/Encore.Button.Secondary.Medium"/>
</androidx.constraintlayout.widget.ConstraintLayout>
