<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/episode_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/full_screen_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/content_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.spotify.encoremobile.viewstub.EncoreViewStub
        android:id="@+id/multitap_seek_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.spotify.encoremobile.viewstub.EncoreViewStub
        android:layout_gravity="start|top"
        android:id="@+id/promotional_indicator_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/encore_spacer_looser_2"/>
</FrameLayout>
