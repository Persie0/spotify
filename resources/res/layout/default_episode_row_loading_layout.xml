<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loading_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    app:shimmer_base_alpha="1"
    app:shimmer_base_color="@color/loading_episode_row_base_color"
    app:shimmer_colored="true"
    app:shimmer_duration="@integer/loading_episode_row_shimmer_duration"
    app:shimmer_highlight_alpha="1"
    app:shimmer_highlight_color="@color/loading_episode_row_highlight_color">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp">
        <View
            android:id="@+id/image"
            android:background="@color/loading_episode_row_base_color"
            android:layout_width="@dimen/track_row_cover_art_size"
            android:layout_height="@dimen/track_row_cover_art_size"
            android:layout_marginTop="9dp"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/title"
            android:background="@drawable/loading_episode_row_title"
            android:layout_width="140sp"
            android:layout_height="16sp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toTopOf="@+id/subtitle"
            app:layout_constraintStart_toEndOf="@+id/image"
            app:layout_constraintTop_toTopOf="@+id/image"
            app:layout_constraintVertical_chainStyle="packed"/>
        <View
            android:id="@+id/subtitle"
            android:background="@drawable/loading_episode_row_subtitle"
            android:layout_width="130sp"
            android:layout_height="13sp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/image"
            app:layout_constraintStart_toEndOf="@+id/image"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:layout_constraintVertical_chainStyle="packed"/>
        <View
            android:id="@+id/description1"
            android:background="@drawable/loading_episode_row_subtitle"
            android:layout_width="180dp"
            android:layout_height="13sp"
            android:layout_marginTop="15dp"
            app:layout_constraintStart_toStartOf="@+id/image"
            app:layout_constraintTop_toBottomOf="@+id/image"/>
        <View
            android:id="@+id/description2"
            android:background="@drawable/loading_episode_row_subtitle"
            android:layout_width="150dp"
            android:layout_height="13sp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@+id/image"
            app:layout_constraintTop_toBottomOf="@+id/description1"/>
        <View
            android:id="@+id/tag_line"
            android:background="@drawable/loading_episode_row_subtitle"
            android:layout_width="90sp"
            android:layout_height="13sp"
            android:layout_marginTop="16dp"
            app:layout_constraintStart_toStartOf="@+id/image"
            app:layout_constraintTop_toBottomOf="@+id/description2"/>
        <View
            android:id="@+id/play_button"
            android:background="@drawable/loading_episode_play_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="13dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tag_line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
