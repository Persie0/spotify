<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.TitleMedium"
        android:id="@+id/section_heading_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/section_heading_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Encore.Components.SectionHeading.Title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.Marginal"
        android:textSize="11sp"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/section_heading_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/section_heading_help_icon"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/section_heading_title"
        style="@style/Encore.Components.SectionHeading.Subtitle"/>
    <ImageButton
        android:id="@+id/section_heading_help_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:contentDescription="@string/help_icon_content_description"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/section_heading_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/section_heading_subtitle"
        app:layout_constraintTop_toTopOf="@+id/section_heading_subtitle"
        style="@style/Encore.Components.SectionHeading.Icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>
