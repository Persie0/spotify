<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row_root"
    android:paddingTop="@dimen/row_vertical_padding"
    android:paddingBottom="@dimen/row_vertical_padding"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/row_horizontal_padding"
    android:paddingVertical="@dimen/row_vertical_padding">
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/artwork_container_age_restricted"
        android:visibility="gone"
        android:layout_width="@dimen/video_row_cover_wide_art_width"
        android:layout_height="@dimen/track_row_cover_art_size"
        android:contentDescription="@null"
        android:layout_marginEnd="@dimen/row_default_horizontal_spacing"
        app:layout_constraintBottom_toTopOf="@+id/bottom_barrier"
        app:layout_constraintEnd_toStartOf="@+id/play_indicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.spotify.encoreconsumermobile.elements.artwork.ArtworkView
        android:id="@+id/artwork"
        android:layout_width="@dimen/track_row_cover_art_size"
        android:layout_height="@dimen/track_row_cover_art_size"
        android:contentDescription="@null"
        android:layout_marginEnd="@dimen/row_default_horizontal_spacing"
        app:iconInset="0dp"
        app:iconInsetRatio="0.5"
        app:layout_constraintBottom_toTopOf="@+id/bottom_barrier"
        app:layout_constraintEnd_toStartOf="@+id/play_indicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Encore.Elements.Artwork.Row"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.Marginal"
        android:textColor="@color/duration_badge_text_color"
        android:id="@+id/duration_badge"
        android:background="@drawable/duration_badge_background"
        android:paddingLeft="@dimen/encore_badge_padding"
        android:paddingTop="@dimen/encore_badge_padding"
        android:paddingRight="@dimen/encore_badge_padding"
        android:paddingBottom="@dimen/encore_badge_padding"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/encore_badge_margin"
        android:fontFeatureSettings="tnum"
        android:paddingHorizontal="@dimen/encore_badge_padding"
        android:paddingVertical="@dimen/encore_badge_padding"
        app:layout_constraintStart_toStartOf="@+id/artwork"
        app:layout_constraintTop_toTopOf="@+id/artwork"/>
    <com.spotify.search.uiusecases.PlayIndicatorComposeView
        android:id="@+id/play_indicator"
        android:visibility="gone"
        android:layout_width="@dimen/encore_play_indicator_default_size"
        android:layout_height="@dimen/encore_play_indicator_default_size"
        android:layout_marginEnd="@dimen/encore_badge_margin"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toStartOf="@+id/title"
        app:layout_constraintStart_toEndOf="@+id/artwork"
        app:layout_constraintTop_toTopOf="@+id/title"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="?attr/baseTextWarning"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/warning_text"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:text="@string/search_age_restricted_video_warning"
        android:maxLines="1"
        android:drawablePadding="4dp"
        android:textDirection="locale"
        app:drawableStartCompat="@drawable/exclamation_icon_resized"
        app:drawableTint="?attr/baseTextWarning"
        app:layout_constraintBottom_toTopOf="@+id/pretitle"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/play_indicator"
        app:layout_constraintTop_toTopOf="@+id/artwork"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textColor="@color/encore_row_subtitle"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/pretitle"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/row_default_text_vertical_spacing"
        android:maxLines="1"
        android:textDirection="locale"
        app:layout_constraintBottom_toTopOf="@+id/title"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/play_indicator"
        app:layout_constraintTop_toBottomOf="@+id/warning_text"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
        android:textColor="@color/encore_row_title"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textDirection="locale"
        android:textAlignment="gravity"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintEnd_toStartOf="@+id/action_bar"
        app:layout_constraintStart_toEndOf="@+id/play_indicator"
        app:layout_constraintTop_toBottomOf="@+id/pretitle"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginEnd="@dimen/row_horizontal_padding"/>
    <com.spotify.encoreconsumermobile.elements.badge.locked.LockedBadgeView
        android:id="@+id/locked_badge"
        android:visibility="gone"
        android:layout_width="@dimen/encore_badge_size"
        android:layout_height="@dimen/encore_badge_size"
        android:layout_marginEnd="@dimen/encore_badge_margin"
        app:layout_constraintBottom_toBottomOf="@+id/subtitle"
        app:layout_constraintEnd_toStartOf="@+id/premium_badge"
        app:layout_constraintStart_toStartOf="@+id/play_indicator"
        app:layout_constraintTop_toTopOf="@+id/subtitle"
        style="@style/LockedBadgeViewInText"/>
    <com.spotify.encoreconsumermobile.elements.badge.premium.PremiumBadgeView
        android:id="@+id/premium_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/encore_badge_size"
        android:layout_marginEnd="@dimen/encore_badge_margin"
        app:layout_constraintBottom_toBottomOf="@+id/subtitle"
        app:layout_constraintEnd_toStartOf="@+id/restriction_badge"
        app:layout_constraintStart_toEndOf="@+id/locked_badge"
        app:layout_constraintTop_toTopOf="@+id/subtitle"/>
    <com.spotify.encoreconsumermobile.elements.badge.contentrestriction.ContentRestrictionBadgeView
        android:id="@+id/restriction_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/encore_badge_size"
        android:layout_marginEnd="@dimen/encore_badge_margin"
        app:layout_constraintBottom_toBottomOf="@+id/subtitle"
        app:layout_constraintEnd_toStartOf="@+id/video_badge"
        app:layout_constraintStart_toEndOf="@+id/premium_badge"
        app:layout_constraintTop_toTopOf="@+id/subtitle"/>
    <com.spotify.encoreconsumermobile.elements.badge.video.VideoBadgeView
        android:id="@+id/video_badge"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/encore_badge_size"
        android:layout_marginEnd="@dimen/encore_badge_margin"
        app:layout_constraintBottom_toBottomOf="@+id/subtitle"
        app:layout_constraintEnd_toStartOf="@+id/subtitle"
        app:layout_constraintStart_toEndOf="@+id/restriction_badge"
        app:layout_constraintTop_toTopOf="@+id/subtitle"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="@color/encore_row_subtitle"
        android:ellipsize="end"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/row_default_text_vertical_spacing"
        android:maxLines="1"
        android:textDirection="locale"
        android:textAlignment="gravity"
        app:layout_constraintBottom_toBottomOf="@+id/artwork"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/video_badge"
        app:layout_constraintTop_toBottomOf="@+id/title"/>
    <com.spotify.search.uiusecases.actionbarsearch.ActionBarComplexRowSearchView
        android:id="@+id/action_bar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/artwork"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/artwork"/>
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/bottom_barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="artwork,subtitle,action_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
