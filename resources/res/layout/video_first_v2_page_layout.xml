<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/pasteColorBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.spotify.encoremobile.viewstub.EncoreViewStub
        android:layout_gravity="top"
        android:id="@+id/minimized_video_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="1dp"/>
    <com.spotify.nowplaying.scroll.view.NowPlayingScrollView
        android:id="@+id/scroll_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/video_and_header_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:elevation="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/header_and_video_content"
                    android:background="?attr/pasteColorBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/player_overlay_header"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHeight_min="@dimen/spacer_48"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.spotify.nowplaying.uiusecases.overlay.OverlayHidingFrameLayout
                        android:id="@+id/overlay_controls_layout"
                        android:background="@color/black_40"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/player_overlay_header">
                        <com.spotify.encoremobile.viewstub.EncoreViewStub
                            android:id="@+id/video_first_track_carousel"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"/>
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/video_overlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <androidx.constraintlayout.widget.Barrier
                                android:id="@+id/carousel_item_safe_barrier_top"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:barrierDirection="top"
                                app:constraint_referenced_ids="video_overlay"/>
                            <androidx.constraintlayout.widget.Barrier
                                android:id="@+id/carousel_item_safe_barrier_bottom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:barrierDirection="bottom"
                                app:constraint_referenced_ids="video_overlay"/>
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/overlay_controls_container"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">
                                <com.spotify.encoremobile.viewstub.EncoreViewStub
                                    android:id="@+id/overlaySecondaryPlaybackButtonLeft"
                                    android:layout_width="@dimen/video_first_action_shift_playback_controls_size"
                                    android:layout_height="@dimen/video_first_action_shift_playback_controls_size"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toStartOf="@+id/overlayPlayPauseButton"
                                    app:layout_constraintHorizontal_chainStyle="packed"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <com.spotify.encoremobile.viewstub.EncoreViewStub
                                    android:id="@+id/overlayPlayPauseButton"
                                    android:layout_width="@dimen/video_first_action_shift_playback_controls_size"
                                    android:layout_height="@dimen/video_first_action_shift_playback_controls_size"
                                    android:layout_marginLeft="@dimen/spacer_48"
                                    android:layout_marginRight="@dimen/spacer_48"
                                    android:layout_marginHorizontal="@dimen/spacer_48"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toStartOf="@+id/overlaySecondaryPlaybackButtonRight"
                                    app:layout_constraintStart_toEndOf="@+id/overlaySecondaryPlaybackButtonLeft"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <com.spotify.encoremobile.viewstub.EncoreViewStub
                                    android:id="@+id/overlaySecondaryPlaybackButtonRight"
                                    android:layout_width="@dimen/video_first_action_shift_playback_controls_size"
                                    android:layout_height="@dimen/video_first_action_shift_playback_controls_size"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/overlayPlayPauseButton"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <com.spotify.encoremobile.viewstub.EncoreViewStub
                                    android:id="@+id/overlay_captions_button"
                                    android:layout_width="@dimen/video_first_action_shift_secondary_controls_size"
                                    android:layout_height="@dimen/video_first_action_shift_secondary_controls_size"
                                    android:layout_marginTop="@dimen/spacer_16"
                                    android:layout_marginBottom="@dimen/spacer_16"
                                    android:layout_marginStart="@dimen/spacer_16"
                                    android:layout_marginEnd="@dimen/spacer_8"
                                    android:layout_marginVertical="@dimen/spacer_16"
                                    app:layout_constraintEnd_toStartOf="@+id/video_settings_button"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <com.spotify.encoremobile.viewstub.EncoreViewStub
                                    android:id="@+id/video_settings_button"
                                    android:layout_width="@dimen/video_first_action_shift_secondary_controls_size"
                                    android:layout_height="@dimen/video_first_action_shift_secondary_controls_size"
                                    android:layout_marginLeft="@dimen/spacer_16"
                                    android:layout_marginTop="@dimen/spacer_16"
                                    android:layout_marginRight="@dimen/spacer_16"
                                    android:layout_marginBottom="@dimen/spacer_16"
                                    android:layout_marginHorizontal="@dimen/spacer_16"
                                    android:layout_marginVertical="@dimen/spacer_16"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                                <com.spotify.encoremobile.viewstub.EncoreViewStub
                                    android:id="@+id/overlayCollapseVideoButton"
                                    android:layout_width="@dimen/video_first_action_shift_secondary_controls_size"
                                    android:layout_height="@dimen/video_first_action_shift_secondary_controls_size"
                                    android:layout_marginLeft="@dimen/spacer_16"
                                    android:layout_marginTop="@dimen/spacer_16"
                                    android:layout_marginRight="@dimen/spacer_16"
                                    android:layout_marginBottom="@dimen/spacer_16"
                                    android:layout_marginHorizontal="@dimen/spacer_16"
                                    android:layout_marginVertical="@dimen/spacer_16"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toStartOf="@+id/overlayFullScreenButton"/>
                                <com.spotify.encoremobile.viewstub.EncoreViewStub
                                    android:id="@+id/overlayFullScreenButton"
                                    android:layout_width="@dimen/video_first_action_shift_secondary_controls_size"
                                    android:layout_height="@dimen/video_first_action_shift_secondary_controls_size"
                                    android:layout_marginLeft="@dimen/spacer_16"
                                    android:layout_marginTop="@dimen/spacer_16"
                                    android:layout_marginRight="@dimen/spacer_16"
                                    android:layout_marginBottom="@dimen/spacer_16"
                                    android:layout_marginHorizontal="@dimen/spacer_16"
                                    android:layout_marginVertical="@dimen/spacer_16"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"/>
                                <com.spotify.encoremobile.viewstub.EncoreViewStub
                                    android:id="@+id/overlayVideoInterceptorButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacer_16"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"/>
                            </androidx.constraintlayout.widget.ConstraintLayout>
                            <FrameLayout
                                android:gravity="center"
                                android:id="@+id/video_interceptor_container"
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">
                                <com.spotify.encoremobile.viewstub.EncoreViewStub
                                    android:id="@+id/video_interceptor_stub"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </FrameLayout>
                        </androidx.constraintlayout.widget.ConstraintLayout>
                        <com.spotify.encoremobile.viewstub.EncoreViewStub
                            android:layout_gravity="start|top"
                            android:id="@+id/promotional_indicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacer_16"
                            android:layout_marginStart="@dimen/spacer_16"/>
                    </com.spotify.nowplaying.uiusecases.overlay.OverlayHidingFrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
            <com.spotify.encoremobile.viewstub.EncoreViewStub
                android:id="@+id/video_overlay_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:elevation="1dp"
                app:layout_constraintBottom_toBottomOf="@+id/video_and_header_container"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/video_and_header_container"/>
            <HorizontalScrollView
                android:id="@+id/buttons_scroll_bar"
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="@dimen/encore_control_size_smaller"
                android:layout_marginTop="@dimen/spacer_8"
                android:isScrollContainer="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/video_and_header_container">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/horizontal_chips_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/playback_controls_margin"
                    android:paddingEnd="@dimen/playback_controls_margin"/>
            </HorizontalScrollView>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/track_info_feedback_container"
                android:paddingLeft="@dimen/playback_controls_margin"
                android:paddingRight="@dimen/playback_controls_margin"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/playback_controls_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttons_scroll_bar">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/feedback_buttons_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.spotify.encoremobile.viewstub.EncoreViewStub
                android:id="@+id/seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/seekbar_margin_horizontal"
                android:layout_marginTop="@dimen/seekbar_margin_vertical"
                android:layout_marginRight="@dimen/seekbar_margin_horizontal"
                android:layout_marginBottom="@dimen/seekbar_margin_vertical"
                android:layout_marginHorizontal="@dimen/seekbar_margin_horizontal"
                android:layout_marginVertical="@dimen/seekbar_margin_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/track_info_feedback_container"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/playback_controls_container"
                android:paddingLeft="@dimen/playback_controls_margin"
                android:paddingTop="@dimen/std_8dp"
                android:paddingRight="@dimen/playback_controls_margin"
                android:paddingBottom="@dimen/std_8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:layoutDirection="ltr"
                android:paddingHorizontal="@dimen/playback_controls_margin"
                android:paddingVertical="@dimen/std_8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/seekbar"/>
            <include
                android:id="@+id/footer_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/footer_button_margin"
                android:layout_marginEnd="@dimen/footer_button_margin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/playback_controls_container"
                layout="@layout/video_first_footer"/>
            <com.spotify.nowplaying.scroll.container.ScrollCardsContainer
                android:id="@+id/widgets_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacer_8"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/footer_container"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.spotify.nowplaying.scroll.view.NowPlayingScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
