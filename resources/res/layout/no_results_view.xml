<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/no_results_message"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.spotify.encoremobile.component.icons.IconPodcasts
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginBottom="24dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@+id/no_results_message"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/no_results_message"
        app:layout_constraintStart_toStartOf="@+id/no_results_message"
        app:tint="?attr/baseTextSubdued"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="@color/gray_70"
        android:gravity="center"
        android:id="@+id/no_results_suggestion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/find_in_show_could_not_find_terms_suggestion"
        app:layout_constraintEnd_toEndOf="@+id/no_results_message"
        app:layout_constraintStart_toStartOf="@+id/no_results_message"
        app:layout_constraintTop_toBottomOf="@+id/no_results_message"/>
</androidx.constraintlayout.widget.ConstraintLayout>
