<?xml version="1.0" encoding="utf-8"?>
<com.spotify.watchfeed.uiusecases.element.mediaitemsframelayout.MediaItemsFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:incrementalChildMarginTop="@dimen/spacer_48"
    app:maxChildHeightPercent="0.65"
    app:maxChildWidthPercent="0.45">
    <FrameLayout
        android:id="@+id/media_item_1_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/media_item_2_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <FrameLayout
        android:layout_gravity="end|bottom"
        android:id="@+id/media_item_3_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</com.spotify.watchfeed.uiusecases.element.mediaitemsframelayout.MediaItemsFrameLayout>
