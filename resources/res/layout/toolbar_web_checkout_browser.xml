<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/toolbar"
    android:background="#4d4d4d"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize">
    <com.spotify.encoremobile.component.buttons.EncoreButton
        android:id="@+id/btn_close"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="10dp"
        app:icon="@drawable/encore_icon_chevron_left"
        style="@style/Encore.Button.Tertiary.Small.IconOnly"/>
    <com.spotify.encoremobile.component.icons.IconLocked
        android:id="@+id/locked_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="@color/white"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@+id/btn_close"
        app:iconActive="true"/>
    <TextView
        android:textAppearance="?attr/pasteTextAppearanceBodyMediumBold"
        android:textStyle="bold"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/page_title"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:text="@string/web_checkout_overlay_browser_title"
        android:maxLines="1"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="15dp"
        android:layout_toEndOf="@+id/locked_icon"/>
    <ProgressBar
        android:id="@+id/webview_progress"
        android:paddingLeft="0dp"
        android:paddingRight="0dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:indeterminate="false"
        android:minHeight="4dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:paddingHorizontal="0dp"
        style="@style/ProgressBar.Horizontal.Green.Dark"/>
</RelativeLayout>
