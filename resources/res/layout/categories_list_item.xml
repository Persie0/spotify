<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:paddingVertical="8dp">
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/std_16dp"
        android:layout_marginRight="@dimen/std_16dp"
        android:maxLines="3"
        android:layout_marginHorizontal="@dimen/std_16dp"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread"/>
    <View
        android:id="@+id/status_dot"
        android:background="@drawable/status_dot_on"
        android:visibility="gone"
        android:layout_width="@dimen/spacer_4"
        android:layout_height="@dimen/spacer_4"
        android:importantForAccessibility="no"
        android:layout_marginStart="@dimen/spacer_16"
        app:layout_constraintBottom_toBottomOf="@+id/subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/subtitle"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="@color/gray_70"
        android:ellipsize="middle"
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:layout_marginStart="@dimen/spacer_4"
        android:layout_marginEnd="@dimen/spacer_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/status_dot"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_goneMarginStart="@dimen/spacer_16"/>
</androidx.constraintlayout.widget.ConstraintLayout>
