<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/message_spacing_height"
    android:layout_marginStart="48dp"
    android:layout_marginEnd="@dimen/std_16dp">
    <com.spotify.encoremobile.component.textview.EncoreTextView
        android:textAppearance="@style/TextAppearance.Encore.BodyMedium"
        android:textColor="@color/user_message_text_color"
        android:id="@+id/message_content"
        android:background="@drawable/message_user_bg"
        android:paddingLeft="12dp"
        android:paddingTop="@dimen/std_16dp"
        android:paddingRight="12dp"
        android:paddingBottom="@dimen/std_16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingVertical="@dimen/std_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.spotify.encoremobile.component.textview.EncoreTextView
        android:textAppearance="@style/TextAppearance.Encore.BodySmall"
        android:textColor="?attr/baseTextNegative"
        android:id="@+id/retry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/std_16dp"
        android:text="@string/tap_to_retry"
        android:textAlignment="viewEnd"
        android:layout_marginEnd="@dimen/std_16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/message_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>
