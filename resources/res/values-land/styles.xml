<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AllBoardingPickerExpandedTitle" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Encore.TitleLarge</item>
        <item name="android:gravity">0x800053</item>
        <item name="android:maxLines">1</item>
        <item name="autoSizeMaxTextSize">32sp</item>
        <item name="autoSizeMinTextSize">16sp</item>
        <item name="autoSizeStepGranularity">2sp</item>
        <item name="autoSizeTextType">uniform</item>
    </style>
    <style name="Widget.Design.TabLayout" parent="@style/Base.Widget.Design.TabLayout">
        <item name="tabGravity">center</item>
        <item name="tabMode">fixed</item>
    </style>
    <style name="Widget.Header.Metadata" parent="@style/Widget.Header">
        <item name="android:textAppearance">?attr/pasteTextAppearanceMetadata</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">0x1</item>
        <item name="android:paddingLeft">96dp</item>
        <item name="android:paddingRight">96dp</item>
