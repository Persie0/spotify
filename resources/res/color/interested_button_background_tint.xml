<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:state_checked="true"
        android:state_selected="true"
        android:color="?attr/brightAccentBackgroundHighlight"/>
    <item
        android:state_checked="true"
        android:state_pressed="true"
        android:color="?attr/brightAccentBackgroundPress"/>
    <item
        android:state_enabled="false"
        android:state_checked="true"
        android:color="?attr/brightAccentBackgroundBase"
        android:alpha="@dimen/opacity_30"/>
    <item
        android:state_checked="true"
        android:color="?attr/brightAccentDecorativeSubdued"
        app:state_progress_indicator_visible="true"/>
    <item
        android:state_checked="true"
        android:color="?attr/brightAccentBackgroundBase"/>
    <item
        android:state_selected="true"
        android:color="?attr/backgroundHighlight"/>
    <item
        android:state_pressed="true"
        android:color="?attr/backgroundPress"/>
    <item
        android:state_enabled="false"
        android:color="?attr/backgroundBase"
        android:alpha="@dimen/opacity_30"/>
    <item
        android:color="?attr/decorativeSubdued"
        app:state_progress_indicator_visible="true"/>
    <item android:color="@android:color/transparent"/>
</selector>
