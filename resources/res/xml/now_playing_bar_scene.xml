<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto">
    <ConstraintSet android:id="@+id/default_size">
        <Constraint android:id="@+id/tracks_carousel_view">
            <Layout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/now_playing_bar_carousel_margin"
                android:layout_marginEnd="@dimen/now_playing_bar_carousel_margin"
                motion:layout_constraintBottom_toBottomOf="parent"
                motion:layout_constraintEnd_toStartOf="@+id/connect_destination_button"
                motion:layout_constraintStart_toEndOf="@+id/content_container"
                motion:layout_constraintTop_toTopOf="parent"/>
        </Constraint>
        <Constraint android:id="@+id/connect_destination_button">
            <Layout
                android:layout_width="@dimen/now_playing_bar_actions_button_size"
                android:layout_height="@dimen/now_playing_bar_actions_button_size"
                motion:layout_constraintBottom_toBottomOf="parent"
                motion:layout_constraintEnd_toStartOf="@+id/skippable_ad_view_stub"
                motion:layout_constraintHorizontal_bias="1"
                motion:layout_constraintHorizontal_chainStyle="packed"
                motion:layout_constraintStart_toEndOf="@+id/tracks_carousel_view"
                motion:layout_constraintTop_toTopOf="parent"/>
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint android:id="@+id/skippable_ad_view_stub">
            <Layout
                android:layout_width="@dimen/now_playing_bar_actions_button_size"
                android:layout_height="@dimen/now_playing_bar_actions_button_size"
                motion:layout_constraintBottom_toBottomOf="parent"
                motion:layout_constraintEnd_toStartOf="@+id/add_to_button"
                motion:layout_constraintStart_toEndOf="@+id/connect_destination_button"
                motion:layout_constraintTop_toTopOf="parent"/>
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint android:id="@+id/add_to_button">
            <Layout
                android:layout_width="@dimen/now_playing_bar_actions_button_size"
                android:layout_height="@dimen/now_playing_bar_actions_button_size"
                motion:layout_constraintBottom_toBottomOf="parent"
                motion:layout_constraintEnd_toStartOf="@+id/play_pause_button"
                motion:layout_constraintStart_toEndOf="@+id/skippable_ad_view_stub"
                motion:layout_constraintTop_toTopOf="parent"/>
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint android:id="@+id/play_pause_button">
            <Layout
                android:layout_width="@dimen/now_playing_bar_actions_button_size"
                android:layout_height="@dimen/now_playing_bar_actions_button_size"
                android:layout_marginRight="@dimen/std_8dp"
                android:layout_marginEnd="@dimen/std_8dp"
                motion:layout_constraintBottom_toBottomOf="parent"
                motion:layout_constraintEnd_toEndOf="parent"
                motion:layout_constraintStart_toEndOf="@+id/add_to_button"
                motion:layout_constraintTop_toTopOf="parent"/>
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint android:id="@+id/device_name_label">
            <Layout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                motion:layout_constraintBottom_toBottomOf="@+id/tracks_carousel_view"
                motion:layout_constraintEnd_toEndOf="@+id/tracks_carousel_view"
                motion:layout_constraintStart_toStartOf="@+id/tracks_carousel_view"
                motion:layout_constraintTop_toTopOf="@+id/tracks_carousel_view"/>
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint android:id="@+id/progress_bar">
            <Layout
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginStart="@dimen/floating_now_playing_bar_content_padding"
                android:layout_marginEnd="@dimen/floating_now_playing_bar_content_padding"
                motion:layout_constraintBottom_toBottomOf="parent"
                motion:layout_constraintEnd_toEndOf="parent"
                motion:layout_constraintStart_toStartOf="parent"/>
        </Constraint>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/large_size">
        <Constraint android:id="@+id/tracks_carousel_view">
            <Layout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/floating_now_playing_bar_content_padding"
                android:layout_marginStart="@dimen/now_playing_bar_carousel_margin"
                android:layout_marginEnd="@dimen/now_playing_bar_large_button_spacing"
                motion:layout_constraintBottom_toBottomOf="parent"
                motion:layout_constraintEnd_toEndOf="parent"
                motion:layout_constraintStart_toEndOf="@+id/content_container"
                motion:layout_constraintTop_toTopOf="parent"
                motion:layout_constraintVertical_bias="0"/>
        </Constraint>
        <Constraint android:id="@+id/connect_destination_button">
            <Layout
                android:layout_width="@dimen/now_playing_bar_actions_button_size"
                android:layout_height="@dimen/now_playing_bar_actions_button_size"
                android:layout_marginBottom="@dimen/now_playing_bar_large_button_spacing"
                motion:layout_constraintBottom_toBottomOf="parent"
                motion:layout_constraintEnd_toStartOf="@+id/skippable_ad_view_stub"
                motion:layout_constraintHorizontal_bias="1"
                motion:layout_constraintHorizontal_chainStyle="packed"
                motion:layout_constraintStart_toEndOf="@+id/tracks_carousel_view"/>
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint android:id="@+id/skippable_ad_view_stub">
            <Layout
                android:layout_width="@dimen/now_playing_bar_actions_button_size"
                android:layout_height="@dimen/now_playing_bar_actions_button_size"
                android:layout_marginBottom="@dimen/now_playing_bar_large_button_spacing"
                android:layout_marginStart="@dimen/now_playing_bar_large_button_spacing"
                motion:layout_constraintBottom_toBottomOf="parent"
                motion:layout_constraintEnd_toStartOf="@+id/add_to_button"
                motion:layout_constraintStart_toEndOf="@+id/connect_destination_button"/>
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint android:id="@+id/add_to_button">
            <Layout
                android:layout_width="@dimen/now_playing_bar_actions_button_size"
                android:layout_height="@dimen/now_playing_bar_actions_button_size"
                android:layout_marginBottom="@dimen/now_playing_bar_large_button_spacing"
                android:layout_marginStart="@dimen/now_playing_bar_large_button_spacing"
                motion:layout_constraintBottom_toBottomOf="parent"
                motion:layout_constraintEnd_toStartOf="@+id/play_pause_button"
                motion:layout_constraintStart_toEndOf="@+id/skippable_ad_view_stub"/>
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint android:id="@+id/play_pause_button">
            <Layout
                android:layout_width="@dimen/now_playing_bar_actions_button_size"
                android:layout_height="@dimen/now_playing_bar_actions_button_size"
                android:layout_marginRight="@dimen/now_playing_bar_large_button_spacing"
                android:layout_marginBottom="@dimen/now_playing_bar_large_button_spacing"
                android:layout_marginStart="@dimen/now_playing_bar_large_button_spacing"
                android:layout_marginEnd="@dimen/now_playing_bar_large_button_spacing"
                motion:layout_constraintBottom_toBottomOf="parent"
                motion:layout_constraintEnd_toEndOf="parent"
                motion:layout_constraintStart_toEndOf="@+id/add_to_button"/>
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint android:id="@+id/device_name_label">
            <Layout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/now_playing_bar_large_connect_label_bottom_margin"
                android:layout_marginStart="@dimen/now_playing_bar_carousel_margin"
                motion:layout_constraintBottom_toBottomOf="@+id/play_pause_button"
                motion:layout_constraintStart_toEndOf="@+id/content_container"/>
            <PropertySet motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint android:id="@+id/progress_bar">
            <Layout
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginStart="@dimen/floating_now_playing_bar_large_content_padding"
                android:layout_marginEnd="@dimen/floating_now_playing_bar_large_content_padding"
                motion:layout_constraintBottom_toBottomOf="parent"
                motion:layout_constraintEnd_toEndOf="parent"
                motion:layout_constraintStart_toStartOf="parent"/>
        </Constraint>
    </ConstraintSet>
    <Transition
        motion:constraintSetEnd="@+id/large_size"
        motion:constraintSetStart="@+id/default_size"
        motion:duration="100"/>
</MotionScene>
